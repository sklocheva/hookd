---
import type { CollectionEntry } from 'astro:content';

/**
 * The finished-measurements table CYC requires, generated from the per-size data.
 *
 * This is the reason `sizes` is structured rather than prose: every pattern gets the
 * same table, in the same order, with the same units, without anyone retyping it. The
 * spec block above states the size *range*; this states the actual numbers.
 *
 * Columns are dropped when no size supplies them, so an accessory with only a length
 * does not show an empty bust column.
 */
interface Props {
	sizes: CollectionEntry<'patterns'>['data']['sizes'];
	/** e.g. "worn with 10–15 cm ease" — stated once, under the table. */
	ease?: string;
}

const { sizes, ease } = Astro.props;

const hasBust = sizes.some((s) => s.finishedBustCm != null);
const hasLength = sizes.some((s) => s.finishedLengthCm != null);

const columns = [
	{ key: 'name', label: 'Size', align: 'left' as const, show: true },
	{ key: 'bust', label: 'Finished bust', align: 'right' as const, show: hasBust },
	{ key: 'length', label: 'Finished length', align: 'right' as const, show: hasLength },
	{ key: 'yardage', label: 'Yarn needed', align: 'right' as const, show: true },
].filter((c) => c.show);

const cell = (s: (typeof sizes)[number], key: string) => {
	switch (key) {
		case 'name':
			return s.name;
		case 'bust':
			return s.finishedBustCm != null ? `${s.finishedBustCm} cm` : '—';
		case 'length':
			return s.finishedLengthCm != null ? `${s.finishedLengthCm} cm` : '—';
		default:
			return `${s.yardageM} m`;
	}
};
---

<section class="sizes">
	<h2>Finished measurements</h2>

	<div class="scroller">
		<table>
			<thead>
				<tr>
					{columns.map((c) => <th style={`text-align:${c.align}`}>{c.label}</th>)}
				</tr>
			</thead>
			<tbody>
				{
					sizes.map((s) => (
						<tr>
							{columns.map((c) => (
								<td style={`text-align:${c.align}`}>{cell(s, c.key)}</td>
							))}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	{ease && <p class="ease">Sized to be {ease}.</p>}
</section>

<style>
	.sizes {
		margin-top: clamp(34px, 4vw, 46px);
	}

	h2 {
		margin: 0 0 18px;
		font: italic 400 22px/1 var(--serif);
		color: var(--ink);
	}

	.scroller {
		overflow-x: auto;
	}

	table {
		width: 100%;
		min-width: 420px;
		border-collapse: collapse;
	}

	th {
		font: 600 11.5px/1.3 var(--sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
		border-bottom: 1px solid var(--rule-strong);
		padding: 0 14px 8px 0;
	}

	td {
		font: 400 13.5px/1.5 var(--sans);
		color: var(--ink-2);
		border-bottom: 1px solid var(--rule-light);
		padding: 10px 14px 10px 0;
	}

	th:last-child,
	td:last-child {
		padding-right: 0;
	}

	.ease {
		margin: 14px 0 0;
		font: 400 13px/1.6 var(--sans);
		color: var(--muted);
	}
</style>
