---
/**
 * Shown at the top of any entry still marked `draft`.
 *
 * It does two jobs.
 *
 * **It says the page is a draft.** A draft is unlisted and served at an unguessable
 * address (see src/lib/drafts.ts), so the only way to be here is to have followed the
 * link from /admin — but the page itself looks finished, and this says it is not.
 *
 * **It says when the page was built.** That is what makes it usable as a preview: save in
 * /admin, open the page, and the timestamp tells you whether you are looking at your last
 * save or at the deploy before it. Without it the honest answer to "is this current?" is
 * "wait about a minute and hope", which is what made the preview useless.
 *
 * The time is rendered in UTC and rewritten to local by a two-line script. With no
 * JavaScript it still reads correctly, just in UTC — the content is in the HTML either way.
 */
const built = new Date();
const iso = built.toISOString();
const utc = built.toISOString().slice(11, 16);
const day = built.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---

<aside class="draft">
	<p class="draft__label">Draft</p>
	<p class="draft__body">
		Not published. This is a private address — the page is listed nowhere on the site and
		its real URL is still a 404. Built <time datetime={iso} data-built>{day}, {utc} UTC</time
		> — if that is before your last save, the deploy has not landed yet.
	</p>
</aside>

<script>
	// The build stamp is UTC so it is correct without JavaScript. Rewrite it to the reader's
	// own clock where we can, because the only question being asked of it is "is this newer
	// than when I hit save", and that is hard to answer across a timezone offset.
	document.querySelectorAll<HTMLTimeElement>('time[data-built]').forEach((el) => {
		const when = new Date(el.dateTime);
		if (Number.isNaN(when.valueOf())) return;
		el.textContent = when.toLocaleString(undefined, {
			day: 'numeric',
			month: 'short',
			hour: '2-digit',
			minute: '2-digit',
		});
	});
</script>

<style>
	.draft {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px 14px;
		margin-top: 30px;
		padding: 14px 16px;
		border: 1px solid var(--ochre-rule);
		/* No fill. --ochre measures 4.43:1 against --panel and passes comfortably on paper,
		   and the gauge panel is meant to be the only filled box on a review — a second one
		   weakens it. The ochre border carries the signal on its own. */
	}

	.draft__label {
		margin: 0;
		font: var(--type-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ochre);
	}

	.draft__body {
		margin: 0;
		flex: 1 1 320px;
		font: 400 13px/1.6 var(--sans);
		color: var(--ink-2);
		text-wrap: pretty;
	}
</style>
