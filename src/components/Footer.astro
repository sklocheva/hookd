---
const year = new Date().getFullYear();

// The link columns. Three short lists rather than one long row, so a reader looking for
// the small print finds it under its own heading instead of at the end of the nav.
const columns = [
	{
		heading: 'Read',
		links: [
			{ label: 'Patterns', href: '/patterns/' },
			{ label: 'Journal', href: '/journal/' },
			{ label: 'Tools', href: '/tools/' },
		],
	},
	{
		heading: 'Hookd',
		links: [
			{ label: 'About', href: '/about/' },
			{ label: 'RSS feed', href: '/rss.xml' },
		],
	},
	{
		heading: 'Small print',
		links: [
			{ label: 'Pattern terms', href: '/licence/' },
			{ label: 'Privacy', href: '/privacy/' },
			{ label: 'Imprint', href: '/imprint/' },
		],
	},
];

// An account with no address is not shown. They used to link to "#", and all three cold
// readers clicked a dead Ravelry button right under a line naming Ravelry. Add the address
// here and the icon appears. Ravelry carries the accent colour; it has no mark of its own,
// so it stays a word.
const accounts: { name: string; href?: string; icon?: 'instagram' | 'youtube' | 'pinterest' }[] = [
	{ name: 'Instagram', href: 'https://www.instagram.com/hookd_works/', icon: 'instagram' },
	{ name: 'YouTube', icon: 'youtube' },
	{ name: 'Pinterest', icon: 'pinterest' },
	{ name: 'Ravelry' },
];
const social = accounts.filter((a) => a.href);
---

<footer class="site-footer">
	<div class="shell">
		<div class="footer-top">
			<div class="brand">
				<a href="/" class="footer-wordmark">hookd<span class="footer-wordmark__stop">.</span></a>
				<p class="blurb">
					Crochet patterns written out in full, and write-ups of yarn, fibre and stitch tests.
				</p>

				<div class="socials">
					{
						social.map((s) => (
							<a
								href={s.href}
								class:list={['social', { 'social--word': !s.icon }]}
								aria-label={`${s.name} (opens in a new tab)`}
								target="_blank"
								rel="noopener"
							>
								{s.icon === 'instagram' && (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<rect x="3.5" y="3.5" width="17" height="17" rx="5" />
										<circle cx="12" cy="12" r="4" />
										<circle cx="17.2" cy="6.8" r="0.9" class="fill" />
									</svg>
								)}
								{s.icon === 'youtube' && (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<rect x="2.5" y="5.5" width="19" height="13" rx="4" />
										<path d="M10 9.2v5.6l4.8-2.8z" class="fill" />
									</svg>
								)}
								{s.icon === 'pinterest' && (
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M9.5 21l2-8.5M11.5 12.5c-.6-2.4.9-4.5 3-4.5 1.9 0 3 1.4 3 3.3 0 2.7-1.4 4.9-3.4 4.9-1.1 0-1.9-.8-1.7-1.9" />
										<path d="M8.2 15.2A7 7 0 1 1 12 19" />
									</svg>
								)}
								{!s.icon && 'RAV'}
							</a>
						))
					}
				</div>
			</div>

			{
				columns.map((col) => (
					<nav class="col" aria-label={col.heading}>
						<p class="col__heading">{col.heading}</p>
						<ul>
							{col.links.map((l) => (
								<li>
									<a href={l.href}>{l.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div class="copyright">
			© {year} Hookd. Anything for sale lives on Ravelry, never here.
		</div>
	</div>
</footer>

<style>
	/* The walnut band. Everything on it is set from the --on-walnut tokens; the site's
	   ink and rust are both unreadable here. */
	.site-footer {
		background: var(--walnut);
		color: var(--on-walnut);
	}

	.site-footer :focus-visible {
		outline-color: var(--on-walnut);
	}

	/* The brand block takes the most room; the three columns share the rest and wrap
	   under it on a phone. Flex rather than a grid so it needs no media query. */
	.footer-top {
		padding-top: clamp(48px, 6vw, 64px);
		display: flex;
		flex-wrap: wrap;
		gap: 36px clamp(32px, 5vw, 64px);
	}

	.brand {
		flex: 2 1 280px;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	/* Footer sizes follow woolyyarn.com: 16px text, 18px column heads. At 14–15px the
	   footer was the smallest text on the page and the author found it the hardest to read. */
	.blurb {
		margin: 0;
		max-width: 340px;
		font: 400 16px/1.6 var(--sans);
		color: var(--on-walnut-quiet);
	}

	.col {
		flex: 1 1 130px;
	}

	.col__heading {
		margin: 0 0 12px;
		font: 600 18px/1.3 var(--sans);
		color: var(--paper);
	}

	.col ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.col a {
		display: inline-block;
		padding-block: 6px;
		font: 400 16px/1.4 var(--sans);
		color: var(--on-walnut);
		text-decoration: none;
	}

	.col a:hover {
		color: var(--paper);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer-wordmark {
		display: inline-block;
		align-self: flex-start;
		padding-block: 3px;
		/* 28px, well above the 19px where -0.05em starts to collide, so it takes the
		   header's tracking. It was 22px and read as a footnote next to the columns. */
		font: 500 28px/1 var(--wordmark);
		letter-spacing: -0.05em;
		color: var(--paper);
		text-decoration: none;
	}

	.footer-wordmark:hover {
		color: var(--paper);
	}

	.footer-wordmark__stop {
		color: var(--on-walnut-stop);
	}

	.socials {
		display: flex;
		gap: 10px;
		margin-top: 6px;
	}

	.social {
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--on-walnut-ring);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--on-walnut);
		text-decoration: none;
	}

	.social:hover {
		color: var(--paper);
		border-color: var(--on-walnut);
	}

	.social svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.social svg .fill {
		fill: currentColor;
		stroke: none;
	}

	.social--word {
		font: var(--type-label);
		letter-spacing: 0.04em;
		color: var(--on-walnut-accent);
	}

	.copyright {
		margin-top: clamp(40px, 5vw, 56px);
		padding: 28px 0 46px;
		border-top: 1px solid var(--on-walnut-rule);
		font: 400 15px/1.6 var(--sans);
		color: var(--on-walnut-quiet);
	}
</style>
