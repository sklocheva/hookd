---
import Hero from './Hero.astro';
import PlaceholderTile from './PlaceholderTile.astro';
import Eyebrow from './Eyebrow.astro';
import { formatDate } from '../lib/format';
import type { JournalEntry } from '../lib/journal';

/**
 * The journal list rows. Shared by /journal/ and /journal/c/[kind]/, which previously
 * carried two copies of this markup and ~90 lines of identical CSS each.
 *
 * Takes already-normalised entries rather than a collection, because the journal lists
 * two collections — test notes and yarn reviews. See src/lib/journal.ts.
 */
interface Props {
	entries: JournalEntry[];
}

const { entries } = Astro.props;
---

<div class="shell list">
	{
		entries.map((entry) => (
			<a href={entry.href} class="row card">
				<div class="row__media">
					{/* An entry with a tile is one that will never be photographed — a quiz,
					    not a shot still to come. See PlaceholderTile.astro. */}
					{entry.tile ? (
						<PlaceholderTile symbol={entry.tile.symbol} caption={entry.tile.caption} ratio="3/2" />
					) : (
						<Hero
							image={entry.heroImage}
							alt={entry.heroImageAlt}
							ratio="3/2"
							caption={entry.title.toLowerCase()}
							widths={[320, 640]}
							sizes="(min-width: 1160px) 320px, 100vw"
						/>
					)}
				</div>

				<div class="row__text hoverable">
					<div class="row__meta">
						<Eyebrow
							kind={entry.kind}
							rest={`· ${formatDate(entry.date)} · ${entry.metaLabel ?? `${entry.readMinutes} min`}`}
							tone="journal"
						/>
					</div>
					<h2 class="hoverable__title">{entry.title}</h2>
					<p class="row__excerpt">{entry.summary}</p>
					{entry.method && <p class="row__method">{entry.method}</p>}
				</div>
			</a>
		))
	}
</div>

<style>
	.list {
		display: flex;
		flex-direction: column;
		gap: clamp(18px, 2.4vw, 26px);
		padding-top: clamp(40px, 5vw, 56px);
	}

	/* A card laid on its side: the photograph runs flush to the left edge, the text sits
	   beside it, and on a phone the two stack like any other card. */
	.row {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	/* The cap is deliberate: without it the image column grows to half the shell and the
	   row reads as a banner rather than a list item. But once the card is too narrow for
	   the two to sit side by side (under 600px) the image is the full width like any other
	   card. The multiplied difference flips the cap between 320px and effectively none
	   without a media query — this site has none. */
	.row__media {
		flex: 1 1 240px;
		max-width: max(320px, (600px - 100%) * 999);
	}

	.row__text {
		flex: 1 1 340px;
		min-width: 0;
		padding: clamp(20px, 3vw, 32px);
	}

	.row__meta {
		margin-bottom: 12px;
	}

	.row__text h2 {
		margin: 0 0 12px;
		font: 400 clamp(24px, 3.2vw, 32px) / 1.18 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.row__excerpt {
		margin: 0 0 12px;
		font: 400 clamp(14.5px, 1.4vw, 16px) / 1.65 var(--sans);
		color: var(--muted);
	}

	.row__method {
		margin: 0;
		font: 400 12px/1.5 var(--sans);
		color: var(--muted);
	}
</style>
