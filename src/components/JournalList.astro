---
import Hero from './Hero.astro';
import Eyebrow from './Eyebrow.astro';
import { formatDate } from '../lib/format';
import type { JournalEntry } from '../lib/journal';

/**
 * The journal list rows. Shared by /journal/ and /journal/c/[kind]/, which previously
 * carried two copies of this markup and ~90 lines of identical CSS each.
 *
 * Takes already-normalised entries rather than a collection, because the journal lists
 * two collections — test notes and yarn reviews. See src/lib/journal.ts.
 */
interface Props {
	entries: JournalEntry[];
}

const { entries } = Astro.props;
---

<div class="shell list">
	{
		entries.map((entry, i) => (
			<a href={entry.href} class:list={['row', { 'row--first': i === 0 }]}>
				<div class="row__media">
					<Hero
						image={entry.heroImage}
						alt={entry.heroImageAlt}
						ratio="3/2"
						caption={entry.title.toLowerCase()}
						widths={[320, 640]}
						sizes="(min-width: 1160px) 320px, 100vw"
					/>
				</div>

				<div class="row__text hoverable">
					<div class="row__meta">
						<Eyebrow
							kind={entry.kind}
							rest={`· ${formatDate(entry.date)} · ${entry.readMinutes} min`}
							tone="journal"
							size={11}
						/>
					</div>
					<h2 class="hoverable__title">{entry.title}</h2>
					<p class="row__excerpt">{entry.summary}</p>
					{entry.method && <p class="row__method">{entry.method}</p>}
				</div>
			</a>
		))
	}
</div>

<style>
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(22px, 3vw, 40px);
		align-items: center;
		text-decoration: none;
		color: inherit;
		border-top: 1px solid var(--rule-light);
		padding-block: clamp(30px, 4vw, 44px);
	}

	.row--first {
		border-top: none;
		padding-top: 34px;
	}

	/* The max-width is deliberate: without it the image column grows to half the shell
	   and the row reads as a banner rather than a list item. */
	.row__media {
		flex: 1 1 240px;
		max-width: 320px;
	}

	.row__text {
		flex: 1 1 340px;
		min-width: 0;
	}

	.row__meta {
		margin-bottom: 12px;
	}

	.row__text h2 {
		margin: 0 0 12px;
		font: 400 clamp(24px, 3.2vw, 32px) / 1.18 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.row__excerpt {
		margin: 0 0 12px;
		font: 400 clamp(14.5px, 1.4vw, 16px) / 1.65 var(--sans);
		color: var(--muted);
	}

	.row__method {
		margin: 0;
		font: 400 12px/1.5 var(--sans);
		color: var(--muted);
	}
</style>
