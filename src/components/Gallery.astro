---
import { Image } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import { resolveImage } from '../lib/images';

/**
 * Extra photographs of one project: a large image with thumbnails that swap it.
 *
 * The point is not decoration — it is a place to put the other photos without having to
 * decide where each one belongs in the article. No lightbox, no modal, no carousel
 * library: a click swaps an image, and that is the whole mechanic.
 *
 * **Without JavaScript every photo is still visible.** All of them render as a plain
 * stacked list; the script collapses that into the swap view on load and only then
 * reveals the thumbnails. Nothing is created by the script, so a crawler that fetches but
 * does not execute still sees every image and its alt text.
 *
 * TWO LAYOUTS, one constant. Flip GALLERY_LAYOUT and compare on a real pattern page.
 * When one wins, delete the other and this constant — see TODO.md.
 */
const GALLERY_LAYOUT: 'below' | 'beside' = 'below';
//                     ^^^^^^^^^^^^^^^^
//  'below'  — thumbnails in a row under the main image, at every width.
//  'beside' — thumbnails in a column to the left of the image on wide screens,
//             collapsing to a row underneath on narrow ones.

export interface GalleryImage {
	image: string;
	alt: string;
}

interface Props {
	images: GalleryImage[];
	/** Fixed so the page cannot jump when the main image changes. */
	ratio?: string;
	heading?: string;
}

const { images, ratio = '1/1', heading = 'More photographs' } = Astro.props;

// resolveImage throws on a missing file, which is the behaviour we want at build time —
// but only for entries that exist. An empty gallery renders nothing at all.
const resolved = images
	.map((g) => ({ ...g, asset: resolveImage(g.image) }))
	.filter((g) => g.asset);
---

{
	resolved.length > 0 && (
		<section class="gallery" data-gallery data-layout={GALLERY_LAYOUT}>
			<SectionLabel>{heading}</SectionLabel>

			<div class="gallery__inner">
				<div class="gallery__stage" style={`--ratio:${ratio}`}>
					{resolved.map((g, i) => (
						<figure class="gallery__slide" data-slide data-index={i}>
							<Image
								src={g.asset!}
								alt={g.alt}
								widths={[400, 800, 1200]}
								sizes="(min-width: 1000px) 700px, 100vw"
								loading={i === 0 ? 'eager' : 'lazy'}
							/>
						</figure>
					))}
				</div>

				{/* Hidden until the script can make it work — a control that does nothing is
				    worse than no control. */}
				<div class="gallery__thumbs" role="tablist" aria-label={heading} hidden>
					{resolved.map((g, i) => (
						<button
							type="button"
							class="thumb"
							role="tab"
							data-thumb
							data-index={i}
							aria-selected={i === 0 ? 'true' : 'false'}
							tabindex={i === 0 ? 0 : -1}
						>
							<Image
								src={g.asset!}
								alt={`Show: ${g.alt}`}
								widths={[120, 240]}
								sizes="80px"
								loading="lazy"
							/>
						</button>
					))}
				</div>
			</div>
		</section>
	)
}

<style>
	.gallery {
		margin-top: clamp(34px, 4vw, 46px);
	}

	/* Capped to the text measure. Unconstrained, a 1:1 image at the full article width is
	   about a screen tall on desktop and dominates the page it is meant to support. */
	.gallery__inner {
		max-width: var(--measure);
	}

	.gallery__stage {
		display: grid;
	}

	/* Every slide occupies the same grid cell, so switching cannot reflow the page.
	   Without JS they are all visible and simply stack — see below. */
	.gallery__slide {
		margin: 0;
	}

	.gallery__slide :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: var(--ratio);
		object-fit: cover;
		display: block;
	}

	/* No-JS: a plain stack, every photo visible, spaced so they read as separate images. */
	.gallery__slide + .gallery__slide {
		margin-top: 14px;
	}

	/* JS on: one cell, one visible slide, no page jump on swap. */
	.gallery[data-ready] .gallery__stage {
		grid-template-areas: 'stage';
	}

	.gallery[data-ready] .gallery__slide {
		grid-area: stage;
		margin-top: 0;
	}

	.gallery[data-ready] .gallery__slide[hidden] {
		display: none;
	}

	.gallery__thumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 14px;
	}

	.thumb {
		width: 72px;
		height: 72px;
		padding: 0;
		border: 1px solid var(--rule-light);
		border-radius: 2px;
		background: none;
		cursor: pointer;
		overflow: hidden;
		line-height: 0;
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.thumb:hover {
		border-color: var(--ink-2);
	}

	/* The current one has to be obvious at a glance, not a one-pixel difference. */
	.thumb[aria-selected='true'] {
		border-color: var(--terracotta);
		box-shadow: 0 0 0 2px var(--terracotta);
	}

	.thumb:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	/* --- layout 2: thumbnails beside the image on wide screens ------------------ */
	@media (min-width: 900px) {
		.gallery[data-layout='beside'] .gallery__inner {
			display: grid;
			/* The thumbnail column is extra, so it sits outside the measure rather than
			   stealing width from the image. */
			max-width: calc(var(--measure) + 88px);
			grid-template-columns: 72px minmax(0, 1fr);
			gap: 16px;
			align-items: start;
		}

		.gallery[data-layout='beside'] .gallery__thumbs {
			order: -1;
			flex-direction: column;
			flex-wrap: nowrap;
			margin-top: 0;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
		const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
		const strip = gallery.querySelector<HTMLElement>('.gallery__thumbs');
		// One photo needs no swapping, so leave it as the plain image it already is.
		if (slides.length < 2 || thumbs.length !== slides.length || !strip) return;

		// Collapse the stack into the swap view. Doing this here rather than in CSS is what
		// keeps the no-JS case honest: until this runs, every photo is on the page.
		gallery.setAttribute('data-ready', '');
		strip.hidden = false;

		let current = 0;

		function select(next: number, moveFocus: boolean) {
			current = (next + slides.length) % slides.length;
			slides.forEach((s, i) => (s.hidden = i !== current));
			thumbs.forEach((t, i) => {
				t.setAttribute('aria-selected', String(i === current));
				t.tabIndex = i === current ? 0 : -1;
			});
			if (moveFocus) thumbs[current].focus();
		}

		thumbs.forEach((t, i) => t.addEventListener('click', () => select(i, false)));

		// Roving tabindex: the strip is one stop in the tab order, arrows move within it.
		strip.addEventListener('keydown', (e) => {
			const keys: Record<string, number> = {
				ArrowLeft: -1,
				ArrowUp: -1,
				ArrowRight: 1,
				ArrowDown: 1,
			};
			if (e.key in keys) {
				e.preventDefault();
				select(current + keys[e.key], true);
			} else if (e.key === 'Home') {
				e.preventDefault();
				select(0, true);
			} else if (e.key === 'End') {
				e.preventDefault();
				select(slides.length - 1, true);
			}
		});

		select(0, false);
	});
</script>
