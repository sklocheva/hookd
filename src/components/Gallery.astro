---
import { Image } from 'astro:assets';
import Hero from './Hero.astro';
import { resolveImage } from '../lib/images';

/**
 * The pattern's photographs: one large frame with a strip of thumbnails that swap it.
 *
 * This is the top of the pattern page and the thing that sells it, so the first frame is
 * the hero — the same image cards and shares use — and the gallery follows on from it.
 *
 * **Without JavaScript every photo is still visible.** They render as a plain stack and
 * the script collapses that into the swap view on load, only then revealing the strip.
 * Nothing is created by the script, so a crawler that fetches but does not execute still
 * sees every image and its alt text.
 *
 * No lightbox, no modal, no carousel library, and deliberately no "2 / 5" counter — the
 * active thumbnail border is the position indicator.
 */
export interface Frame {
	image?: string;
	alt: string;
	caption?: string;
}

interface Props {
	frames: Frame[];
	/** Portrait: garment shots need the height, and it keeps the mobile stack off letterbox. */
	ratio?: string;
	/** Passed through to the hero's designed "photography still to come" state. */
	pendingNote?: string;
}

const { frames, ratio = '4/5', pendingNote } = Astro.props;

// A frame with no file is the hero before its photo exists — Hero renders the designed
// pending state for it. Gallery entries always have a file, so they resolve or throw.
const shots = frames.filter((f) => f.image || f === frames[0]);
const swappable = shots.length > 1;

// The strip is always five columns wide so it lines up with the frame above it. With
// fewer shots the trailing cells stay empty rather than four thumbnails stretching.
const COLUMNS = 5;
---

<div class="gallery" data-gallery={swappable ? '' : undefined}>
	<div class="gallery__stage" style={`--ratio:${ratio}`}>
		{
			shots.map((f, i) => (
				<figure
					class="gallery__slide"
					data-slide
					data-index={i}
					data-caption={f.caption ?? ''}
				>
					{i === 0 && !f.image ? (
						<Hero
							image={f.image}
							alt={f.alt}
							ratio={ratio}
							caption="pattern"
							pending
							pendingNote={pendingNote}
						/>
					) : (
						<Image
							src={resolveImage(f.image)!}
							alt={f.alt}
							widths={[420, 840, 1120]}
							sizes="(min-width: 900px) 560px, 100vw"
							loading={i === 0 ? 'eager' : 'lazy'}
						/>
					)}
				</figure>
			))
		}
	</div>

	{
		swappable && (
			<div
				class="gallery__thumbs"
				style={`--columns:${COLUMNS}`}
				role="tablist"
				aria-label="Photographs"
				hidden
			>
				{shots.map((f, i) => (
					<button
						type="button"
						class="thumb"
						role="tab"
						data-thumb
						data-index={i}
						aria-label={f.alt}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
					>
						{f.image && (
							<Image src={resolveImage(f.image)!} alt="" widths={[200, 400]} sizes="110px" loading="lazy" />
						)}
					</button>
				))}
			</div>
		)
	}

	{
		shots.some((f) => f.caption) && (
			<p class="gallery__caption" data-caption>
				{shots[0].caption ?? ''}
			</p>
		)
	}
</div>

<style>
	.gallery__stage {
		display: grid;
	}

	.gallery__slide {
		margin: 0;
	}

	.gallery__slide :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: var(--ratio);
		object-fit: cover;
		display: block;
	}

	/* No JS: a plain stack, every photo visible and separated. */
	.gallery__slide + .gallery__slide {
		margin-top: 14px;
	}

	/* JS on: every slide shares one grid cell, so a swap cannot reflow the page. */
	.gallery[data-ready] .gallery__stage {
		grid-template-areas: 'stage';
	}

	.gallery[data-ready] .gallery__slide {
		grid-area: stage;
		margin-top: 0;
	}

	.gallery[data-ready] .gallery__slide[hidden] {
		display: none;
	}

	/* Exactly as wide as the frame above it — the alignment is the point. */
	.gallery__thumbs {
		display: grid;
		grid-template-columns: repeat(var(--columns), 1fr);
		gap: clamp(8px, 1.2vw, 12px);
		margin-top: clamp(8px, 1.2vw, 12px);
	}

	.thumb {
		display: block;
		width: 100%;
		aspect-ratio: var(--ratio, 4/5);
		padding: 0;
		border: 1px solid var(--rule);
		background: none;
		cursor: pointer;
		overflow: hidden;
		line-height: 0;
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.thumb:hover {
		border-color: var(--ink-2);
	}

	.thumb[aria-selected='true'] {
		border-color: var(--terracotta);
	}

	.thumb:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 3px;
	}

	.gallery__caption {
		margin: 14px 0 0;
		font: 400 12.5px/1.5 var(--sans);
		color: var(--muted);
		text-wrap: pretty;
	}

	.gallery__caption:empty {
		display: none;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
		const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
		const strip = gallery.querySelector<HTMLElement>('.gallery__thumbs');
		const caption = gallery.querySelector<HTMLElement>('[data-caption]');
		if (slides.length < 2 || thumbs.length !== slides.length || !strip) return;

		// Collapsing the stack here rather than in CSS is what keeps the no-JS case honest:
		// until this runs, every photo is on the page.
		gallery.setAttribute('data-ready', '');
		strip.hidden = false;

		const captions = slides.map((s) => s.dataset.caption ?? '');
		let current = 0;

		function select(next: number, moveFocus: boolean) {
			current = (next + slides.length) % slides.length;
			slides.forEach((s, i) => (s.hidden = i !== current));
			thumbs.forEach((t, i) => {
				t.setAttribute('aria-selected', String(i === current));
				t.tabIndex = i === current ? 0 : -1;
			});
			if (caption) caption.textContent = captions[current];
			if (moveFocus) thumbs[current].focus();
		}

		thumbs.forEach((t, i) => t.addEventListener('click', () => select(i, false)));

		// Roving tabindex: the strip is one stop in the tab order, arrows move within it.
		strip.addEventListener('keydown', (e) => {
			const step: Record<string, number> = {
				ArrowLeft: -1,
				ArrowUp: -1,
				ArrowRight: 1,
				ArrowDown: 1,
			};
			if (e.key in step) {
				e.preventDefault();
				select(current + step[e.key], true);
			} else if (e.key === 'Home') {
				e.preventDefault();
				select(0, true);
			} else if (e.key === 'End') {
				e.preventDefault();
				select(slides.length - 1, true);
			}
		});

		select(0, false);
	});
</script>
