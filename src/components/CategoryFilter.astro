---
import type { CollectionEntry } from 'astro:content';
import {
	MIN_PATTERNS_TO_FILTER,
	categoryHref,
	categoryLabel,
	patternCategoriesInUse,
	patternCategoryCounts,
} from '../lib/taxonomy';

/**
 * The pattern filter bar.
 *
 * Rendered as ordinary links to the `/patterns/c/<slug>/` pages, which are real static
 * routes. That is what a crawler and a reader without JavaScript get, and it is a complete
 * experience on its own — single-select, but it works.
 *
 * The script upgrades them into multi-select toggles that filter the grid in place and
 * record the selection in the query string. Nothing appears that was not already in the
 * HTML, so the no-client-only-content rule holds: the script hides cards, it never makes
 * them.
 *
 * Below MIN_PATTERNS_TO_FILTER patterns the bar does not render at all — filtering three
 * things is noise, and a control that barely changes the page reads as broken.
 */
interface Props {
	patterns: CollectionEntry<'patterns'>[];
	/** Pre-selected on the static category pages, so the bar shows where you are. */
	active?: string[];
}

const { patterns, active = [] } = Astro.props;

const inUse = patternCategoriesInUse(patterns);
const counts = patternCategoryCounts(patterns);
const show = patterns.length >= MIN_PATTERNS_TO_FILTER && inUse.length > 1;
---

{
	show && (
		<nav class="filters" aria-label="Filter patterns by category" data-category-filter>
			<a
				href="/patterns/"
				class:list={['filter', 'filter--all', { 'filter--on': active.length === 0 }]}
				data-all
			>
				All<span class="filter__count">{patterns.length}</span>
			</a>

			{inUse.map((c) => (
				<a
					href={categoryHref(c)}
					class:list={['filter', { 'filter--on': active.includes(c) }]}
					data-category={c}
				>
					{categoryLabel(c)}
					<span class="filter__count">{counts.get(c) ?? 0}</span>
				</a>
			))}

			<p class="filters__status" role="status" aria-live="polite" />
		</nav>
	)
}

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		padding-bottom: 18px;
	}

	/* 11px floor, --ink-2 rather than --muted, tracking at the low end of the range —
	   the house rule for small uppercase, which is the hardest thing on a page to read. */
	.filter {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		min-height: 34px; /* WCAG 2.5.8 wants 24; the design wants a comfortable target */
		padding: 6px 14px;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		font: 600 11px/1 var(--sans);
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-2);
		text-decoration: none;
	}

	.filter:hover {
		border-color: var(--terracotta);
		color: var(--terracotta);
	}

	.filter--on {
		background: var(--terracotta);
		border-color: var(--terracotta);
		color: var(--paper);
	}

	.filter--on:hover {
		color: var(--paper);
	}

	.filter__count {
		font-variant-numeric: tabular-nums;
		font-weight: 400;
		opacity: 0.75;
	}

	.filters__status {
		margin: 0;
		font: var(--type-note);
		color: var(--muted);
	}

	.filters__status:empty {
		display: none;
	}
</style>

<script>
	// Progressive enhancement. Without this the links above still work — they go to the
	// static category pages. With it, they become multi-select toggles.
	document.querySelectorAll<HTMLElement>('[data-category-filter]').forEach((bar) => {
		const all = bar.querySelector<HTMLAnchorElement>('[data-all]');
		const toggles = [...bar.querySelectorAll<HTMLAnchorElement>('[data-category]')];
		const status = bar.querySelector<HTMLElement>('.filters__status');
		const cards = [...document.querySelectorAll<HTMLElement>('[data-pattern-categories]')];
		if (!all || !toggles.length || !cards.length) return;

		// Re-bound after the guard: `apply` is a hoisted declaration, so TypeScript will
		// not carry the null check above into it.
		const allButton = all;

		// They are toggles now, not destinations.
		for (const el of [allButton, ...toggles]) {
			el.setAttribute('role', 'button');
			el.setAttribute('aria-pressed', String(el.classList.contains('filter--on')));
		}

		const selected = new Set<string>();

		function apply(pushUrl: boolean) {
			let shown = 0;
			for (const card of cards) {
				const own = (card.dataset.patternCategories ?? '').split(' ').filter(Boolean);
				// OR, not AND: ticking Clothing and Pets shows both, which is what someone
				// browsing expects. AND would empty the page as soon as they tick twice.
				const match = selected.size === 0 || own.some((c) => selected.has(c));
				card.hidden = !match;
				if (match) shown++;
			}

			allButton.classList.toggle('filter--on', selected.size === 0);
			allButton.setAttribute('aria-pressed', String(selected.size === 0));
			for (const t of toggles) {
				const on = selected.has(t.dataset.category!);
				t.classList.toggle('filter--on', on);
				t.setAttribute('aria-pressed', String(on));
			}

			if (status) {
				status.textContent = selected.size === 0 ? '' : `${shown} of ${cards.length} shown`;
			}

			if (pushUrl) {
				const url = new URL(window.location.href);
				if (selected.size) url.searchParams.set('category', [...selected].join(','));
				else url.searchParams.delete('category');
				history.replaceState(null, '', url);
			}
		}

		for (const t of toggles) {
			t.addEventListener('click', (e) => {
				e.preventDefault();
				const c = t.dataset.category!;
				if (selected.has(c)) selected.delete(c);
				else selected.add(c);
				apply(true);
			});
		}

		allButton.addEventListener('click', (e) => {
			e.preventDefault();
			selected.clear();
			apply(true);
		});

		// Restore from the URL so a filtered view can be linked and survives a refresh.
		const known = new Set(toggles.map((t) => t.dataset.category!));
		for (const c of new URL(window.location.href).searchParams.get('category')?.split(',') ?? []) {
			if (known.has(c)) selected.add(c);
		}
		apply(false);
	});
</script>
