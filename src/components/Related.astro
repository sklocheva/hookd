---
import Hero from './Hero.astro';
import Eyebrow from './Eyebrow.astro';
import { formatDate } from '../lib/format';
import type { RelatedItem } from '../lib/related';

/**
 * "Read next" strip at the foot of an article.
 *
 * Cross-type by design: a pattern sends you to the test behind its yarn advice, a test
 * sends you to a pattern that uses the finding. That round trip is the reason both
 * halves of the site exist, so the strip makes it visible rather than leaving it to
 * a reader to guess.
 */
interface Props {
	items: RelatedItem[];
	/** Section label. The two templates word it differently. */
	heading?: string;
}

const { items, heading = 'Read next' } = Astro.props;
---

{
	items.length > 0 && (
		<section class="related band band--cream band--bleed" aria-labelledby="read-next">
			<div class="section-head">
				<h2 id="read-next">{heading}</h2>
			</div>

			<ul class="grid">
				{items.map((item) => (
					<li>
						<a href={item.href} class="card hoverable">
							<Hero
									image={item.heroImage}
									alt={item.heroImageAlt}
									ratio="3/2"
									caption={item.title.toLowerCase()}
									widths={[280, 560]}
									sizes="(min-width: 1000px) 300px, 100vw"
								/>
							<div class="card__body">
								<Eyebrow kind={item.kind} rest={`· ${formatDate(item.date)}`} tone={item.tone} />
								<h3 class="hoverable__title">{item.title}</h3>
								<p>{item.summary}</p>
							</div>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	/* The cream band at the foot of an article, just above the footer: the article ends,
	   the band says "and next". */
	.related {
		margin-top: clamp(56px, 7vw, 88px);
		padding-block: clamp(48px, 6vw, 72px);
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: clamp(26px, 3vw, 34px);
	}

	.grid > li {
		display: flex;
	}

	.grid .card {
		flex: 1;
	}

	h3 {
		margin: 0;
		font: 400 clamp(19px, 2.1vw, 22px) / 1.25 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	p {
		margin: 0;
		font: 400 13.5px/1.6 var(--sans);
		color: var(--muted);
		/* Two lines keeps the three cards the same height without a fixed height. */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
