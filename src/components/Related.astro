---
import Hero from './Hero.astro';
import Eyebrow from './Eyebrow.astro';
import { formatDate } from '../lib/format';
import SectionLabel from './SectionLabel.astro';
import type { RelatedItem } from '../lib/related';

/**
 * "Read next" strip at the foot of an article.
 *
 * Cross-type by design: a pattern sends you to the test behind its yarn advice, a test
 * sends you to a pattern that uses the finding. That round trip is the reason both
 * halves of the site exist, so the strip makes it visible rather than leaving it to
 * a reader to guess.
 */
interface Props {
	items: RelatedItem[];
	/** Section label. The two templates word it differently. */
	heading?: string;
}

const { items, heading = 'Read next' } = Astro.props;
---

{
	items.length > 0 && (
		<section class="related" aria-labelledby="read-next">
			<SectionLabel id="read-next">{heading}</SectionLabel>

			<ul class="grid">
				{items.map((item) => (
					<li>
						<a href={item.href} class="card hoverable">
							<div class="card__media">
								<Hero
									image={item.heroImage}
									alt={item.heroImageAlt}
									ratio="3/2"
									caption={item.title.toLowerCase()}
									widths={[280, 560]}
									sizes="(min-width: 1000px) 300px, 100vw"
								/>
							</div>
							<Eyebrow kind={item.kind} rest={`· ${formatDate(item.date)}`} tone={item.tone} />
							<h3 class="hoverable__title">{item.title}</h3>
							<p>{item.summary}</p>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.related {
		margin-top: clamp(44px, 6vw, 68px);
		padding-top: clamp(28px, 4vw, 38px);
		border-top: 1px solid var(--rule-strong);
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: clamp(26px, 3vw, 34px);
	}

	.card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card__media {
		margin-bottom: 14px;
	}

	/* The eyebrow sits between image and title, so it needs its own breathing room. */
	.card :global(.eyebrow) {
		margin-bottom: 8px;
	}

	h3 {
		margin: 0 0 8px;
		font: 400 clamp(19px, 2.1vw, 22px) / 1.25 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	p {
		margin: 0;
		font: 400 13.5px/1.6 var(--sans);
		color: var(--muted);
		/* Two lines keeps the three cards the same height without a fixed height. */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
