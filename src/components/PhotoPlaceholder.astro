---
/**
 * Diagonal-stripe stand-in for photography that has not been shot yet.
 *
 * This is scaffolding, not a designed state — delete it once real images land and
 * swap in Astro's <Image>. The caption doubles as the shot list, so it states the
 * subject and the aspect ratio the layout depends on.
 *
 * For the *designed* absent-photo state on pattern cards, see PhotoPending.astro.
 */
interface Props {
	/** e.g. "cardigan, worn, 4:5" */
	caption: string;
	/** CSS aspect-ratio value, e.g. "4/5". */
	ratio: string;
}

const { caption, ratio } = Astro.props;
---

<div class="ph" data-scaffold style={`aspect-ratio:${ratio}`}>
	<span>PHOTO — {caption}</span>
</div>

<style>
	.ph {
		width: 100%;
		background: repeating-linear-gradient(
			135deg,
			var(--ph-stripe-a) 0 16px,
			var(--ph-stripe-b) 16px 32px
		);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 12px;
		text-align: center;
	}

	span {
		font: 11px/1.4 var(--mono);
		color: var(--ph-caption);
	}
</style>
