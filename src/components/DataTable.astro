---
/**
 * Results table for journal posts — the defining element of that template.
 *
 * Takes rows as data so the styling stays out of the author's hands, which also keeps
 * it editable in Sveltia. Used inside MDX:
 *
 *   <DataTable
 *     columns={['Yarn', 'Dry', 'Wet', 'After wash', 'Change']}
 *     align={['left', 'right', 'right', 'right', 'right']}
 *     minWidth={520}
 *     rows={[['Hillesvåg', '32', '31', '30.5', '−4.7%']]}
 *   />
 *
 * It scrolls rather than squashing on mobile, which is why minWidth exists.
 */
interface Props {
	columns: string[];
	rows: (string | number)[][];
	/** Per-column alignment. Numeric columns should be right-aligned. */
	align?: ('left' | 'right')[];
	/** Below this width the table scrolls horizontally instead of compressing. */
	minWidth?: number;
	caption?: string;
}

const { columns, rows, align = [], minWidth = 520, caption } = Astro.props;
const alignFor = (i: number) => align[i] ?? (i === 0 ? 'left' : 'right');
---

<div class="scroller">
	<table style={`min-width:${minWidth}px`}>
		{caption && <caption>{caption}</caption>}
		<thead>
			<tr>
				{columns.map((c, i) => <th style={`text-align:${alignFor(i)}`}>{c}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((r) => (
					<tr>
						{r.map((cell, i) => (
							<td style={`text-align:${alignFor(i)}`}>{cell}</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>

<style>
	/* Tables are allowed to run the full content column, wider than the prose measure. */
	.scroller {
		overflow-x: auto;
		margin: 28px 0;
	}

	table {
		width: 100%;
		border-collapse: collapse;
	}

	caption {
		text-align: left;
		font: 400 12.5px/1.5 var(--sans);
		color: var(--muted);
		padding-bottom: 10px;
	}

	th {
		font: 600 9.5px/1.3 var(--sans);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--muted);
		border-bottom: 1px solid var(--rule-strong);
		padding: 0 14px 8px 0;
	}

	td {
		font: 400 13.5px/1.5 var(--sans);
		color: var(--ink-2);
		border-bottom: 1px solid var(--rule-light);
		padding: 10px 14px 10px 0;
	}

	th:last-child,
	td:last-child {
		padding-right: 0;
	}
</style>
