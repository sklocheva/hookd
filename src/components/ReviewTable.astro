---
import RatingBars from './RatingBars.astro';

/**
 * The two reference tables on a yarn review: "The yarn" and "In the hand".
 *
 * Both are the same object — a label column and a value column, hairline between rows —
 * so they are one component. The only difference is what sits in the value cell: plain
 * text for transcribed ball-band facts, a five-bar judgement over a sentence for the
 * reviewer's own notes.
 *
 * Real `<th scope="row">` labels rather than styled divs, because this genuinely is a
 * table of label/value pairs and a screen reader should be able to say which is which.
 */
export interface ReviewRow {
	label: string;
	/** The plain value. Used on its own, or as the sentence under a rating. */
	text?: string;
	/** Muted trailing clause, e.g. "(one ball ≈ 6 squares)". */
	aside?: string;
	/** 1–5. Present on judgement rows and on the price band. */
	score?: number;
	/** Only the price row: the words at each end of the band. */
	endLabels?: [string, string];
}

interface Props {
	heading: string;
	/** The muted line beside the heading, e.g. "Ball band and shop data". */
	subheading?: string;
	rows: ReviewRow[];
	/** The muted line under the table. */
	footnote?: string;
}

const { heading, subheading, rows, footnote } = Astro.props;
---

<section class="spec">
	<div class="spec__head">
		<h2 class="spec__heading">{heading}</h2>
		{subheading && <p class="spec__sub">{subheading}</p>}
	</div>

	<div class="spec__scroller">
		<table>
			<tbody>
				{
					rows.map((r) => (
						<tr>
							<th scope="row">{r.label}</th>
							<td>
								{r.score !== undefined && (
									<div class="spec__rating">
										<RatingBars
											score={r.score}
											height={r.endLabels ? 8 : 6}
											maxWidth={r.endLabels ? 300 : 130}
											gap={r.endLabels ? 4 : 3}
											label={r.text ? undefined : `${r.label}: ${r.score} out of 5`}
										/>
										{r.endLabels && (
											<div class="spec__ends" style="max-width:300px">
												<span>{r.endLabels[0]}</span>
												<span>{r.endLabels[1]}</span>
											</div>
										)}
									</div>
								)}
								{r.text}
								{r.aside && <span class="spec__aside"> {r.aside}</span>}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>

	{footnote && <p class="spec__footnote">{footnote}</p>}
</section>

<style>
	.spec {
		margin-top: clamp(30px, 4vw, 40px);
	}

	.spec__head {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 20px;
		align-items: baseline;
		margin-bottom: 16px;
	}

	.spec__heading {
		margin: 0;
		font: italic 400 21px/1 var(--serif);
		color: var(--ink);
	}

	.spec__sub {
		margin: 0;
		font: 400 12.5px/1.4 var(--sans);
		color: var(--muted);
	}

	.spec__scroller {
		overflow-x: auto;
	}

	table {
		width: 100%;
		max-width: 760px;
		border-collapse: collapse;
		font: 400 15px/1.55 var(--sans);
		color: var(--ink);
	}

	/* The label column is uppercase and small, so it takes the 11px floor and --ink-2's
	   darker cousin rather than --muted: it is a heading, and it has to stay readable. */
	th {
		width: 44%;
		min-width: 150px;
		text-align: left;
		vertical-align: top;
		padding: 12px 18px 12px 0;
		border-top: 1px solid var(--rule);
		font: var(--type-label-sm);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--label-ink);
	}

	td {
		padding: 12px 0;
		border-top: 1px solid var(--rule);
		vertical-align: top;
		text-wrap: pretty;
	}

	tr:last-child th,
	tr:last-child td {
		border-bottom: 1px solid var(--rule);
	}

	.spec__rating {
		margin-bottom: 7px;
	}

	.spec__ends {
		display: flex;
		justify-content: space-between;
		margin-top: 7px;
		font: 400 11.5px/1.3 var(--sans);
		/* --faint is 3.76:1 — scaffolding only. These labels ship. */
		color: var(--muted);
	}

	.spec__aside {
		color: var(--muted);
	}

	.spec__footnote {
		margin: 10px 0 0;
		font: 400 12px/1.5 var(--sans);
		color: var(--muted);
	}
</style>
