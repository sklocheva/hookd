---
/**
 * The small uppercase line above a title: a coloured kind, then muted trailing meta.
 *
 * Appears on the homepage feed, the journal list, and both article templates — four
 * near-identical copies before this existed. The tone carries the meaning: terracotta
 * for patterns, ochre for journal, so the two content types stay distinguishable
 * everywhere they sit side by side.
 */
interface Props {
	/** The coloured label, e.g. "Pattern" or "How-tos". */
	kind: string;
	/** Muted trailing text, e.g. "· 12 Aug 2026 · 14 min". Rendered as given. */
	rest?: string;
	tone?: 'pattern' | 'journal' | 'neutral';
}

const { kind, rest, tone = 'pattern' } = Astro.props;
---

<div class="eyebrow">
	<span class:list={['kind', `kind--${tone}`]}>{kind}</span>
	{rest && <span class="rest"> {rest}</span>}
</div>

<style>
	.eyebrow {
		font: var(--type-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.kind--pattern {
		color: var(--terracotta);
	}

	.kind--journal {
		color: var(--ochre);
	}

	/* --annotation is for scaffolding captions that get deleted; it is too light for
	   text that ships. The "Pinned" eyebrow is real UI, so it uses --muted (4.66:1). */
	.kind--neutral {
		color: var(--muted);
	}

	/* The trailing meta drops out of the label style — same line, different voice. */
	.rest {
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--muted);
	}
</style>
