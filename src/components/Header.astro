---
import '../styles/global.css';

interface Props {
	/** Which nav item reads as current. The homepage has no active item. */
	active?: 'patterns' | 'journal' | 'about';
}

const { active } = Astro.props;

const nav = [
	{ label: 'Free patterns', href: '/patterns/', key: 'patterns' },
	{ label: 'Journal', href: '/journal/', key: 'journal' },
	{ label: 'About', href: '/about/', key: 'about' },
] as const;
---

<header class="shell site-header">
	<div>
		<a href="/" class="wordmark-box">
			<span class="wordmark">Hookd</span>
		</a>
		{/* Placeholder scaffolding: delete the dashed box and this caption when real
		    wordmark artwork lands. */}
		<div class="annotation" data-scaffold>Logo artwork — replace with wordmark image</div>
	</div>

	<nav>
		{
			nav.map((item) => (
				<a
					href={item.href}
					class:list={['nav-link', { 'nav-link--active': active === item.key }]}
					aria-current={active === item.key ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<div class="shell"><div class="hairline"></div></div>

<style>
	.site-header {
		padding-top: 50px;
		padding-bottom: 26px;
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		justify-content: space-between;
		align-items: flex-end;
	}

	.wordmark-box {
		display: inline-block;
		border: 1px dashed var(--border-dashed);
		padding: 14px 26px;
		text-decoration: none;
	}

	.wordmark {
		font: italic 500 clamp(32px, 5vw, 46px) / 1 var(--script);
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.annotation {
		margin-top: 9px;
		font: var(--type-mono-caption);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--annotation);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 22px;
		font: 600 13px/1 var(--sans);
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.nav-link {
		color: var(--muted);
		text-decoration: none;
		/* 13px text in a 13px box was under the 24px minimum hit area. */
		display: inline-block;
		padding-block: 6px;
	}

	.nav-link:hover {
		color: var(--ink);
	}

	.nav-link--active {
		color: var(--ink);
		box-shadow: inset 0 -1px 0 var(--rule-active);
	}
</style>
