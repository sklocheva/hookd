---
import '../styles/global.css';

interface Props {
	/** Which nav item reads as current. The homepage has no active item. */
	active?: 'patterns' | 'journal' | 'about';
}

const { active } = Astro.props;

const nav = [
	{ label: 'Patterns', href: '/patterns/', key: 'patterns' },
	{ label: 'Journal', href: '/journal/', key: 'journal' },
	{ label: 'About', href: '/about/', key: 'about' },
] as const;
---

<header class="shell site-header">
	{/* Live text, not an image. The full stop is the only decoration the mark gets. */}
	<a href="/" class="wordmark">hookd<span class="wordmark__stop">.</span></a>

	<nav>
		{
			nav.map((item) => (
				<a
					href={item.href}
					class:list={['nav-link', { 'nav-link--active': active === item.key }]}
					aria-current={active === item.key ? 'page' : undefined}
				>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<div class="shell"><div class="hairline"></div></div>

<style>
	.site-header {
		padding-top: 50px;
		padding-bottom: 26px;
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		justify-content: space-between;
		align-items: flex-end;
	}

	.wordmark {
		/* Larger than the 40px in the spec. Space Grotesk at 40px sat quieter next to
		   Newsreader headings than the wordmark should. */
		font: 500 clamp(32px, 5vw, 52px) / 1 var(--wordmark);
		/* Tight tracking is what makes it read as set rather than typed. It loosens to
		   -0.04em at 19px and below, where -0.05em starts to collide — see the footer. */
		letter-spacing: -0.05em;
		color: var(--ink);
		text-decoration: none;
	}

	.wordmark__stop {
		/* The design names #b1603f. That is this site's rust before it was corrected to
		   4.5:1, and --terracotta is the corrected value of the same accent. A brand mark
		   is exempt from the contrast rule, but there is no reason to keep a second rust
		   around for one character. */
		color: var(--terracotta);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 22px;
		font: var(--type-nav);
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.nav-link {
		color: var(--muted);
		text-decoration: none;
		/* 13px text in a 13px box was under the 24px minimum hit area. */
		display: inline-block;
		padding-block: 6px;
	}

	.nav-link:hover {
		color: var(--ink);
	}

	.nav-link--active {
		color: var(--ink);
		box-shadow: inset 0 -1px 0 var(--rule-active);
	}
</style>
