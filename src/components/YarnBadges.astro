---
/**
 * Certification marks, shown only when there is one.
 *
 * These were table rows. As rows they had to print something on every review, so a yarn
 * with nothing certified said "Not stated" twice — two lines of nothing, on a page whose
 * rule is that an unrecorded fact is simply absent. As badges they exist or they do not,
 * which is what these facts are.
 *
 * Only positive claims appear. "Not stated" earns no badge, so silence on the label is
 * silence on the page and a missing badge never reads as an accusation.
 *
 * The component renders in two parts, because they belong in different places: the badges
 * sit at the top with the lede where they are a quick signal, and `note` explains OEKO-TEX
 * at the foot of the page where fine print belongs.
 */
interface Props {
	oekoTexClass?: number;
	mulesing?: string;
	/** 'badges' at the top of the page, 'note' at the bottom. */
	part: 'badges' | 'note';
}

const { oekoTexClass, mulesing, part } = Astro.props;

const OEKO_TEX_CLASSES: Record<number, string> = {
	1: 'babies and children up to three',
	2: 'direct skin contact',
	3: 'no direct skin contact',
	4: 'decoration',
};

const badges = [
	oekoTexClass ? `OEKO-TEX® STANDARD 100 · Class ${oekoTexClass}` : undefined,
	mulesing === 'Mulesing-free' ? 'Mulesing-free' : undefined,
].filter((b): b is string => b != null);
---

{
	part === 'badges' && badges.length > 0 && (
		<ul class="badges">
			{badges.map((b) => (
				<li class="badge">{b}</li>
			))}
		</ul>
	)
}

{
	part === 'note' && oekoTexClass && (
		<p class="badges__note">
			OEKO-TEX® STANDARD 100 means every component of the yarn was tested against limits for
			harmful substances, in the class shown — {OEKO_TEX_CLASSES[oekoTexClass]}.
		</p>
	)
}

<style>
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 18px 0 0;
		padding: 0;
		list-style: none;
	}

	.badge {
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		padding: 6px 13px;
		/* 11px floor, --ink-2 not --muted — the house rule for small uppercase. */
		font: 600 11px/1.3 var(--sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
	}

	.badges__note {
		max-width: 640px;
		margin: 0 0 16px;
		font: 400 12.5px/1.55 var(--sans);
		color: var(--muted);
		text-wrap: pretty;
	}
</style>
