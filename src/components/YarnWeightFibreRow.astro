---
import { FIBRES } from '../lib/yarn-weight';

/**
 * One row of the fibre blend: a fibre, its percentage, and a remove button.
 *
 * A component of its own because it is rendered twice — once as the first row in the page,
 * and once inside the <template> the script clones when a reader adds a fibre. Sharing the
 * markup is what keeps the two identical, and keeping the styles here (rather than in the
 * calculator) is what makes them reach the clones: Astro scopes CSS by attribute, and a
 * clone carries the attributes its source had.
 *
 * The script numbers the accessible names ("Fibre 2") after every add and remove, and sets
 * the percentage placeholder. What is written here is only the starting point.
 *
 * **Every row starts with no fibre chosen.** The first row was pre-filled as 100% wool and
 * added rows as cotton, which meant a reader who typed a length got an answer at once and
 * never looked at step 2 — and a blend picked up a cotton nobody asked for.
 */
interface Props {
	/** Empty for a row the reader has not filled in yet. */
	fibre?: string;
	pct?: string;
}

const { fibre = '', pct = '' } = Astro.props;
---

<div class="row" data-yw-row>
	<select class="row__fibre" data-yw-fibre aria-label="Fibre 1">
		<option value="" selected={fibre === ''}>Choose a fibre</option>
		{FIBRES.map(([name]) => <option value={name} selected={name === fibre}>{name}</option>)}
	</select>

	<div class="row__pct">
		<input
			class="row__pct-input"
			type="number"
			min="0"
			max="100"
			step="any"
			inputmode="decimal"
			aria-label="Percentage of fibre 1"
			value={pct}
			data-yw-pct
		/>
		<span class="row__pct-unit" aria-hidden="true">%</span>
	</div>

	<button type="button" class="row__remove is-hidden" data-yw-remove aria-label="Remove fibre 1">
		<span aria-hidden="true">×</span>
	</button>
</div>

<style>
	.row {
		display: flex;
		gap: 8px;
		align-items: stretch;
	}

	.row__fibre {
		flex: 1;
		min-width: 0;
		min-height: 52px;
		padding: 0 12px;
		background: var(--field);
		border: 1px solid var(--field-border);
		border-radius: 0;
		font: 400 16px/1 var(--sans);
		color: var(--ink);
		cursor: pointer;
	}

	/* "Choose a fibre" reads as a prompt, not as a fibre called that. --muted on --field is
	   4.9:1. The options themselves stay in ink, or some browsers grey the whole list. */
	.row__fibre:has(option[value='']:checked) {
		color: var(--muted);
	}

	.row__fibre option {
		color: var(--ink);
	}

	/* Widths come from the calculator, which shares them with the total beneath the rows. */
	.row__pct {
		flex: none;
		display: flex;
		align-items: stretch;
		width: var(--pct-w, 96px);
		background: var(--field);
		border: 1px solid var(--field-border);
	}

	.row__pct-input {
		flex: 1;
		min-width: 0;
		padding: 0 10px;
		background: transparent;
		border: none;
		border-radius: 0;
		font: 400 16px/1 var(--sans);
		color: var(--ink);
	}

	/* The ring goes round the whole boxed field, not the bare input inside it. */
	.row__pct:has(.row__pct-input:focus-visible) {
		outline: 2px solid var(--terracotta);
		outline-offset: 2px;
	}

	.row__pct-input:focus-visible {
		outline: none;
	}

	.row__pct-unit {
		flex: none;
		display: flex;
		align-items: center;
		padding-right: 12px;
		font: 400 14px/1 var(--sans);
		color: var(--muted);
	}

	.row__remove {
		flex: none;
		width: var(--rm-w, 44px);
		min-height: 52px;
		background: none;
		border: 1px solid var(--rule);
		font: 400 20px/1 var(--serif);
		color: var(--muted);
		cursor: pointer;
	}

	.row__remove:hover {
		color: var(--terracotta);
		border-color: var(--terracotta);
	}

	/* Hidden but still occupying its column. Removing it from the layout resized the row
	   beside it: on a phone the fibre select dropped from 215px to 155px the instant a
	   second fibre was added, which truncated "Bamboo viscose" to "Bamboo visco" in a row
	   the reader had already filled in. The script also takes it out of the tab order and
	   the accessibility tree while it is in this state. */
	.row__remove.is-hidden {
		visibility: hidden;
	}
</style>
