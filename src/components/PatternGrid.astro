---
import type { CollectionEntry } from 'astro:content';
import PatternCard from './PatternCard.astro';

/** The pattern card grid, shared by /patterns/ and /patterns/c/[category]/. */
interface Props {
	patterns: CollectionEntry<'patterns'>[];
}

const { patterns } = Astro.props;
---

<div class="shell grid">
	{patterns.map((pattern) => <PatternCard pattern={pattern} />)}
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
		gap: clamp(20px, 2.4vw, 28px);
		padding-top: clamp(40px, 5vw, 56px);
	}
</style>
