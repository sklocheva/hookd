---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { formatDate, patternSpecLine } from '../lib/format';
import { allJournalEntries } from '../lib/journal';
import { QUIZ_KIND, YARN_KIND } from '../lib/taxonomy';

// Drafts are absent from every listing, this one included — see src/lib/drafts.ts.
const [patterns, posts, reviews, quizzes] = await Promise.all([
	getCollection('patterns', ({ data }) => !data.draft),
	getCollection('posts', ({ data }) => !data.draft),
	getCollection('reviews', ({ data }) => !data.draft),
	getCollection('quizzes', ({ data }) => !data.draft),
]);

type Tone = 'pattern' | 'journal' | 'quiz';

type FeedItem = {
	/** The badge in the tile's corner — says what kind of thing this is before the title. */
	badge: string;
	tone: Tone;
	title: string;
	href: string;
	date: Date;
	spec?: string;
	/** What the link line says. A quiz is taken, not read — that is the difference to show. */
	cta: string;
	photo: string;
	/** Path as stored in frontmatter, resolved by Hero. */
	image?: string;
	imageAlt: string;
	/** A quiz has nothing to photograph; its tile is drawn instead. */
	symbol?: string;
};

// Everything the journal lists, quizzes and yarn notes included, goes in alongside the
// patterns. A quiz used to be left out, so the newest entry on the site could be missing
// from "Latest".
const journal = allJournalEntries(posts, reviews, quizzes);

const feed: FeedItem[] = [
	...patterns.map((p) => ({
		badge: 'Pattern',
		tone: 'pattern' as const,
		title: p.data.title,
		href: `/patterns/${p.id}/`,
		date: p.data.date,
		spec: patternSpecLine(p.data),
		cta: 'Read the pattern',
		photo: p.data.title.toLowerCase(),
		image: p.data.heroImage,
		imageAlt: p.data.heroImageAlt,
	})),
	...journal.map((e) => {
		const quiz = e.kind === QUIZ_KIND;
		return {
			badge: quiz ? 'Quiz' : e.kind,
			tone: quiz ? ('quiz' as const) : ('journal' as const),
			title: e.title,
			href: e.href,
			date: e.date,
			spec: e.method,
			cta: quiz ? 'Take the quiz' : e.kind === YARN_KIND ? 'Read the notes' : 'Read the post',
			photo: e.title.toLowerCase(),
			image: e.heroImage,
			imageAlt: e.heroImageAlt,
			symbol: e.tile?.symbol,
		};
	}),
]
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, 4);

// Four across, two by two, or one — never three and one left over. Pairs that wrap as a
// unit do it without a media query: each pair is two tiles or one, and the pairs sit side
// by side or stacked.
const pairs = [feed.slice(0, 2), feed.slice(2, 4)].filter((pair) => pair.length > 0);

/**
 * Editorially pinned, in rotation order. Hand-picked rather than derived — this is the
 * one editorial slot on the site.
 *
 * Keyed on the entry rather than on a written-out URL. The hrefs used to be typed here as
 * strings, which meant a pick could quietly point at a page that no longer existed: the
 * moment drafts stopped being served at their real slug, two of these three pinned the
 * homepage to a 404. Resolving against the published entries means a pick that is
 * unpublished, renamed or deleted drops out of the rotation instead of breaking it.
 */
const picks = [
	{
		collection: 'patterns' as const,
		slug: 'halland-cowl',
		excerpt:
			'A single-skein cowl in garter-look crochet, picked to open the season — free while the wool lasts.',
		cta: 'Read the pattern →',
		photo: 'cowl styled',
	},
	{
		collection: 'patterns' as const,
		slug: 'fjord-yoke-pullover',
		excerpt:
			'The one everyone asks about — a top-down circular yoke, still our most-repeated pattern.',
		cta: 'Read the pattern →',
		photo: 'blanket folded, textured',
	},
	{
		collection: 'posts' as const,
		slug: 'leftover-wool-cat-toy',
		excerpt:
			'Non-superwash scraps, a yarn needle and a normal wash — a light, bouncy felted ball with nothing synthetic in it.',
		cta: 'Read the notes →',
		photo: 'felted wool balls',
	},
];

const pinned = picks.flatMap((pick) => {
	const pool = pick.collection === 'patterns' ? patterns : posts;
	const entry = pool.find((e) => e.id === pick.slug);
	if (!entry) return [];

	const base = pick.collection === 'patterns' ? '/patterns' : '/journal';
	// Title and photograph come from the entry, so a featured slot cannot drift from what
	// the page says — or show a placeholder while the entry has a real photo.
	return [
		{
			...pick,
			title: entry.data.title,
			href: `${base}/${entry.id}/`,
			image: entry.data.heroImage,
			imageAlt: entry.data.heroImageAlt,
		},
	];
});

---

<Base
	title="Hookd — crochet patterns and yarn tests"
	description="Crochet patterns written out in full, and write-ups of yarn, fibre and stitch tests."
>
	<h1 class="visually-hidden">Hookd — crochet patterns and yarn tests</h1>

	{
		/* A pick that is unpublished or deleted drops out above, so this can end up
		   empty — an empty rotator is a bordered box with nothing in it. */
		/* Every pinned entry is rendered server-side; the script only toggles which is
		   visible. Crawlers that fetch but do not execute JS still see the first. */
		pinned.length > 0 && (
			<div class="band band--cream">
			<section class="shell pinned" data-rotator>
			{
				pinned.map((item, i) => (
					<div class="pinned__slide" data-slide hidden={i !== 0}>
						<a href={item.href} class="pinned__media" tabindex={i === 0 ? undefined : -1}>
							<Hero image={item.image} alt={item.imageAlt} ratio="4/5" caption={item.photo} widths={[300, 520, 1040]} sizes="(min-width: 1160px) 520px, 100vw" loading="eager" />
						</a>
						<div class="pinned__text">
							<div class="pinned__eyebrow">Featured</div>
							<h2>{item.title}</h2>
							<p>{item.excerpt}</p>
							<a href={item.href} class="button">
								{item.cta}
							</a>
							{/* One set of dots per slide, so they sit under the text the way
							    the design has them. Only the visible slide's set is ever shown. */}
							<div class="dots" role="tablist" aria-label="Featured posts">
								{
									pinned.map((other, j) => (
										<button
											type="button"
											class:list={['dot', { 'dot--on': j === i }]}
											data-dot
											data-index={j}
											role="tab"
											aria-selected={j === i ? 'true' : 'false'}
											aria-label={`Show featured post: ${other.title}`}
										>
											<span class="dot__mark" aria-hidden="true" />
										</button>
									))
								}
							</div>
						</div>
					</div>
				))
			}
		</section>
		</div>
		)
	}

	<section class="shell section">
		<div class="section-head">
			<h2>Latest</h2>
			<p>New patterns, posts and quizzes, most recent first.</p>
		</div>

		<div class="latest">
			{
				pairs.map((pair) => (
					<div class="latest__pair">
						{pair.map((item) => (
							<a href={item.href} class:list={['tile', `tile--${item.tone}`]}>
								{item.symbol ? (
									<span class="tile__drawn" aria-hidden="true">
										<span class="tile__symbol">{item.symbol}</span>
									</span>
								) : (
									<Hero
										image={item.image}
										alt={item.imageAlt}
										ratio="4/5"
										caption={item.photo}
										widths={[300, 600]}
										sizes="(min-width: 1160px) 270px, (min-width: 560px) 50vw, 100vw"
									/>
								)}
								<span class="tile__badge">{item.badge}</span>
								{/* A photograph tile's fade guarantees at least 72% walnut behind the text, so
								    this is what it is read against when the photo under it is pure white. */}
								<span class="tile__text" data-contrast-bg="#72665e">
									<span class="tile__date">{formatDate(item.date)}</span>
									<span class="tile__title">{item.title}</span>
									{item.spec && <span class="tile__spec">{item.spec}</span>}
									<span class="tile__link">{item.cta} →</span>
								</span>
							</a>
						))}
					</div>
				))
			}
		</div>

		{/* The three sections, at the same weight — the same button three times. */}
		<div class="section-foot latest__more">
			<a href="/patterns/" class="button button--outline">All patterns</a>
			<a href="/journal/" class="button button--outline">The whole journal</a>
			<a href="/tools/" class="button button--outline">Tools</a>
		</div>
	</section>
</Base>

<script>
	// Progressive enhancement only: without this the first pinned entry stays visible
	// and every link still works.
	const rotator = document.querySelector('[data-rotator]');
	if (rotator) {
		const slides = Array.from(rotator.querySelectorAll('[data-slide]')) as HTMLElement[];
		const dots = Array.from(rotator.querySelectorAll('[data-dot]')) as HTMLElement[];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let index = 0;
		let timer: number | undefined;
		// Once a reader picks a slide, it stays. Rotating away from something they chose to
		// look at is the one thing a carousel must not do.
		let chosen = false;

		function show(next: number) {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				const on = i === index;
				slide.hidden = !on;
				const link = slide.querySelector('a');
				if (link) link.tabIndex = on ? 0 : -1;
			});
			dots.forEach((dot) => {
				const on = Number(dot.dataset.index) === index;
				dot.classList.toggle('dot--on', on);
				dot.setAttribute('aria-selected', on ? 'true' : 'false');
			});
		}

		function start() {
			if (reduced.matches || chosen) return;
			stop();
			timer = window.setInterval(() => show(index + 1), 8000);
		}
		function stop() {
			if (timer) window.clearInterval(timer);
			timer = undefined;
		}

		dots.forEach((dot) =>
			dot.addEventListener('click', () => {
				const next = Number(dot.dataset.index);
				const hadFocus = document.activeElement === dot;
				chosen = true;
				stop();
				show(next);
				// The dot pressed lives in the slide that just hid. Move focus to its twin
				// in the slide now showing, or a keyboard user is dropped back to the top.
				if (hadFocus) slides[index].querySelector<HTMLElement>(`[data-dot][data-index="${next}"]`)?.focus();
			})
		);

		// Pausing on hover and focus keeps the thing readable.
		rotator.addEventListener('mouseenter', stop);
		rotator.addEventListener('mouseleave', start);
		rotator.addEventListener('focusin', stop);
		rotator.addEventListener('focusout', start);
		reduced.addEventListener('change', start);

		start();
	}
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	/* Pinned hero */
	/* Every slide shares one grid cell, so the carousel is always as tall as its tallest
	   slide. With display:none on the hidden ones it changed height on every turn — 67px
	   on a phone — which moved everything below it and put a button where a dot had been. */
	.pinned {
		padding-block: clamp(36px, 5vw, 64px);
		position: relative;
		display: grid;
	}

	.pinned__slide {
		display: flex;
		/* The photograph sits on the right, and stacks above the text on a phone. */
		flex-direction: row-reverse;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: clamp(24px, 4vw, 52px);
		align-items: center;
	}

	.pinned__slide {
		grid-area: 1 / 1;
	}

	/* Hidden slides keep their space; visibility also takes them out of the tab order and
	   the accessibility tree, as display:none did. */
	.pinned__slide[hidden] {
		display: flex;
		visibility: hidden;
	}

	.pinned__media {
		flex: 1 1 46%;
		min-width: 280px;
		max-width: 520px;
		text-decoration: none;
		display: block;
	}

	.pinned__text {
		flex: 1 1 40%;
		min-width: 280px;
	}

	.pinned__eyebrow {
		font: var(--type-label);
		/* --annotation is scaffolding-only (3.76:1). This label ships. */
		color: var(--muted);
		margin-bottom: 18px;
	}

	.pinned__text h2 {
		margin: 0 0 18px;
		font: 400 clamp(30px, 4.2vw, 44px) / 1.12 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.pinned__text p {
		margin: 0 0 30px;
		font: var(--type-lede);
		color: var(--muted);
		max-width: 440px;
		text-wrap: pretty;
	}

	.dots {
		display: flex;
		/* The visual gap stays 8px: each button is 24px around a 9px mark, so the
		   marks sit 8px apart while the tap areas meet the 24px minimum. */
		gap: 0;
		margin-top: 32px;
		margin-left: -7px;
	}

	/* The dot the design specifies is 9px. A 9px tap target is not usable on a phone,
	   so the button is 24px and transparent, and the 9px mark is drawn inside it. */
	.dot {
		width: 24px;
		height: 24px;
		display: grid;
		place-items: center;
		border: none;
		padding: 0;
		background: none;
		cursor: pointer;
	}

	.dot__mark {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--dot-inactive);
	}

	.dot--on .dot__mark {
		background: var(--walnut);
	}

	/* Latest: pairs side by side (four across), stacked (two by two), or each pair one
	   tile wide on a phone. */
	.latest {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 500px), 1fr));
		gap: clamp(14px, 1.8vw, 22px);
	}

	.latest__pair {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
		gap: clamp(14px, 1.8vw, 22px);
	}

	.tile {
		position: relative;
		display: block;
		border-radius: var(--radius-image);
		overflow: hidden;
		text-decoration: none;
		box-shadow: var(--shadow-card);
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.tile:hover {
		box-shadow: var(--shadow-card-hover);
		transform: translateY(-2px);
	}

	/* The fade that carries the text, over the lower 75%. It reaches 72% walnut a fifth of
	   the way in and deepens from there, so the whole text block sits on at least that:
	   5.17:1 for cream even over a white photograph. The text is at most about 150px tall
	   and the smallest tile is 230 × 288, so it never climbs above the 72% line. */
	.tile:not(.tile--quiz)::after {
		content: '';
		position: absolute;
		inset: 25% 0 0;
		background: linear-gradient(
			180deg,
			transparent,
			color-mix(in srgb, var(--walnut) 72%, transparent) 20%,
			color-mix(in srgb, var(--walnut) 86%, transparent)
		);
		pointer-events: none;
	}

	/* A quiz has no photograph, and it is not a post: its tile is walnut, drawn rather
	   than photographed, with the question mark where a picture would be. */
	.tile__drawn {
		display: grid;
		place-items: start center;
		aspect-ratio: 4 / 5;
		padding-top: 18%;
		background: var(--walnut);
	}

	.tile__symbol {
		font: 400 clamp(88px, 11vw, 120px) / 1 var(--serif);
		color: var(--on-walnut-stop);
	}

	/* What kind of thing it is, before the title: a pattern, a post's kind, or a quiz. */
	.tile__badge {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 1;
		padding: 6px 11px;
		border-radius: 999px;
		font: var(--type-label);
		background: var(--paper);
		color: var(--ink);
	}

	.tile--pattern .tile__badge {
		background: var(--terracotta);
		color: var(--paper);
	}

	.tile--journal .tile__badge {
		background: var(--ochre);
		color: var(--paper);
	}

	.tile__text {
		position: absolute;
		left: 20px;
		right: 20px;
		bottom: 18px;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 6px;
		color: var(--paper);
	}

	.tile__date {
		font: 400 14px/1.3 var(--sans);
	}

	.tile__title {
		font: 400 clamp(21px, 2.2vw, 25px) / 1.15 var(--serif);
		text-wrap: pretty;
	}

	.tile__spec {
		font: 400 14px/1.45 var(--sans);
	}

	.tile__link {
		margin-top: 4px;
		font: 600 16px/1.3 var(--sans);
	}

	.tile:hover .tile__title {
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
	}

	.latest__more {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
	}
</style>
