---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { formatDate, patternSpecLine } from '../lib/format';

const [patterns, posts] = await Promise.all([
	getCollection('patterns'),
	getCollection('posts'),
]);

type FeedItem = {
	kind: 'Pattern' | 'Journal';
	title: string;
	href: string;
	date: Date;
	summary: string;
	spec?: string;
	photo: string;
	/** Path as stored in frontmatter, resolved by Hero. */
	image?: string;
};

const feed: FeedItem[] = [
	...patterns.map((p) => ({
		kind: 'Pattern' as const,
		title: p.data.title,
		href: `/patterns/${p.id}/`,
		date: p.data.date,
		summary: p.data.summary,
		spec: patternSpecLine(p.data),
		photo: p.data.title.toLowerCase(),
		image: p.data.heroImage,
	})),
	...posts.map((p) => ({
		kind: 'Journal' as const,
		title: p.data.title,
		href: `/journal/${p.id}/`,
		date: p.data.date,
		summary: p.data.summary,
		spec: p.data.method,
		photo: p.data.title.toLowerCase(),
		image: p.data.heroImage,
	})),
]
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, 4);


// Editorially pinned, in rotation order. Deliberately hand-picked rather than derived —
// this is the one editorial slot on the site.
const pinned = [
	{
		title: 'Halland Cowl',
		excerpt:
			'A single-skein cowl in garter-look crochet, picked to open the season — free while the wool lasts.',
		cta: 'Read the pattern →',
		href: '/patterns/halland-cowl/',
		photo: 'cowl styled',
	},
	{
		title: 'Fjord Yoke Pullover',
		excerpt:
			'The one everyone asks about — a top-down circular yoke, still our most-repeated pattern.',
		cta: 'Read the pattern →',
		href: '/patterns/fjord-yoke-pullover/',
		photo: 'blanket folded, textured',
	},
	{
		title: 'Leftover wool into a cat toy',
		excerpt:
			'Non-superwash scraps, a yarn needle and a normal wash — a light, bouncy felted ball with nothing synthetic in it.',
		cta: 'Read the notes →',
		href: '/journal/leftover-wool-cat-toy/',
		photo: 'felted wool balls',
	},
];
---

<Base
	title="Hookd — free crochet patterns and yarn tests"
	description="Free crochet patterns written out in full, and write-ups of yarn, fibre and stitch tests."
>
	<h1 class="visually-hidden">Hookd — free crochet patterns and yarn tests</h1>

	{/* All three pinned entries are rendered server-side; the script only toggles which
	    is visible. Crawlers that fetch but do not execute JS still see the first. */}
	<section class="shell pinned" data-rotator>
		{
			pinned.map((item, i) => (
				<div class="pinned__slide" data-slide hidden={i !== 0}>
					<a href={item.href} class="pinned__media" tabindex={i === 0 ? undefined : -1}>
						<Hero alt={item.title} ratio="4/5" caption={item.photo} widths={[300, 520, 1040]} sizes="(min-width: 1160px) 520px, 100vw" loading="eager" />
					</a>
					<div class="pinned__text">
						<div class="pinned__eyebrow">Pinned</div>
						<h2>{item.title}</h2>
						<p>{item.excerpt}</p>
						<a href={item.href} class="pinned__cta">
							{item.cta}
						</a>
					</div>
				</div>
			))
		}

		<div class="dots" role="tablist" aria-label="Pinned posts">
			{
				pinned.map((item, i) => (
					<button
						type="button"
						class:list={['dot', { 'dot--on': i === 0 }]}
						data-dot
						data-index={i}
						role="tab"
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-label={`Show pinned post: ${item.title}`}
					>
						<span class="dot__mark" aria-hidden="true" />
					</button>
				))
			}
		</div>
	</section>

	<div class="shell latest-bar">
		<div class="latest-bar__title">Latest</div>
		<div class="latest-bar__filters label">
			<a href="/" class="filter filter--active" aria-current="page">All</a>
			<a href="/patterns/" class="filter">Free patterns</a>
			<a href="/journal/" class="filter">Journal</a>
		</div>
	</div>

	<section class="shell feed">
		{
			feed.map((item) => (
				<a href={item.href} class="feed__row hoverable">
					<div class="feed__thumb">
						<Hero image={item.image} alt={item.title} ratio="1/1" caption={item.photo} widths={[140, 280]} sizes="140px" />
					</div>
					<div class="feed__text">
						<div class="feed__meta">
							<Eyebrow
								kind={item.kind}
								rest={`· ${formatDate(item.date)}`}
								tone={item.kind === 'Pattern' ? 'pattern' : 'journal'}
								size={11}
							/>
						</div>
						<h3 class="hoverable__title">{item.title}</h3>
						<p class="feed__excerpt">{item.summary}</p>
						{item.spec && <p class="feed__spec">{item.spec}</p>}
					</div>
				</a>
			))
		}
	</section>

	<section class="shell archive">
		<div class="hairline"></div>
		<p class="archive__line">
			You're looking at our latest posts — the rest live in the archive.
		</p>
		<div class="archive__ctas label">
			<a href="/patterns/" class="cta--terracotta">All free patterns →</a>
			<a href="/journal/" class="cta--ochre">Read the journal →</a>
		</div>
	</section>
</Base>

<script>
	// Progressive enhancement only: without this the first pinned entry stays visible
	// and every link still works.
	const rotator = document.querySelector('[data-rotator]');
	if (rotator) {
		const slides = Array.from(rotator.querySelectorAll('[data-slide]')) as HTMLElement[];
		const dots = Array.from(rotator.querySelectorAll('[data-dot]')) as HTMLElement[];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let index = 0;
		let timer: number | undefined;

		function show(next: number) {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				const on = i === index;
				slide.hidden = !on;
				const link = slide.querySelector('a');
				if (link) link.tabIndex = on ? 0 : -1;
			});
			dots.forEach((dot, i) => {
				dot.classList.toggle('dot--on', i === index);
				dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
			});
		}

		function start() {
			if (reduced.matches) return;
			stop();
			timer = window.setInterval(() => show(index + 1), 5000);
		}
		function stop() {
			if (timer) window.clearInterval(timer);
			timer = undefined;
		}

		dots.forEach((dot) =>
			dot.addEventListener('click', () => {
				show(Number(dot.dataset.index));
				start();
			})
		);

		// Pausing on hover and focus keeps the thing readable.
		rotator.addEventListener('mouseenter', stop);
		rotator.addEventListener('mouseleave', start);
		rotator.addEventListener('focusin', stop);
		rotator.addEventListener('focusout', start);
		reduced.addEventListener('change', start);

		start();
	}
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	/* Pinned hero */
	.pinned {
		padding-block: clamp(28px, 4vw, 44px);
		position: relative;
	}

	.pinned__slide {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(24px, 4vw, 52px);
		align-items: center;
	}

	.pinned__slide[hidden] {
		display: none;
	}

	.pinned__media {
		flex: 1 1 46%;
		min-width: 280px;
		max-width: 520px;
		text-decoration: none;
		display: block;
	}

	.pinned__text {
		flex: 1 1 40%;
		min-width: 280px;
	}

	.pinned__eyebrow {
		font: var(--type-label);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		/* --annotation is scaffolding-only (3.76:1). This label ships. */
		color: var(--muted);
		margin-bottom: 18px;
	}

	.pinned__text h2 {
		margin: 0 0 18px;
		font: 400 clamp(30px, 4.2vw, 44px) / 1.12 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.pinned__text p {
		margin: 0 0 30px;
		font: var(--type-lede);
		color: var(--muted);
		max-width: 440px;
		text-wrap: pretty;
	}

	.pinned__cta {
		display: inline-block;
		padding-block: 7px;
		font: var(--type-cta);
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--terracotta);
		text-decoration: none;
	}

	.dots {
		display: flex;
		/* The visual gap stays 8px: each button is 24px around a 9px mark, so the
		   marks sit 8px apart while the tap areas meet the 24px minimum. */
		gap: 0;
		margin-top: 32px;
		margin-left: -7px;
	}

	/* The dot the design specifies is 9px. A 9px tap target is not usable on a phone,
	   so the button is 24px and transparent, and the 9px mark is drawn inside it. */
	.dot {
		width: 24px;
		height: 24px;
		display: grid;
		place-items: center;
		border: none;
		padding: 0;
		background: none;
		cursor: pointer;
	}

	.dot__mark {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--dot-inactive);
	}

	.dot--on .dot__mark {
		background: var(--terracotta);
	}

	/* Latest bar */
	.latest-bar {
		padding-bottom: 16px;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: space-between;
		align-items: baseline;
	}

	.latest-bar__title {
		font: italic 400 clamp(18px, 2vw, 21px) / 1 var(--serif);
		color: var(--ink);
	}

	.latest-bar__filters {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	/* Feed */
	.feed__row {
		display: flex;
		gap: clamp(16px, 2vw, 24px);
		align-items: center;
		padding-block: clamp(18px, 2vw, 22px);
		border-top: 1px solid var(--rule-light);
		text-decoration: none;
		color: inherit;
	}

	.feed__thumb {
		width: clamp(100px, 20vw, 140px);
		flex: none;
	}

	.feed__text {
		flex: 1;
		min-width: 0;
	}

	.feed__meta {
		margin-bottom: 10px;
	}

	.feed__text h3 {
		margin: 0 0 8px;
		font: 400 clamp(19px, 2.2vw, 24px) / 1.25 var(--serif);
		color: var(--ink);
	}

	.feed__excerpt {
		margin: 0 0 8px;
		font: 400 clamp(12.5px, 1.3vw, 14px) / 1.55 var(--sans);
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.feed__spec {
		margin: 0;
		font: 400 clamp(10.5px, 1.1vw, 11.5px) / 1.5 var(--sans);
		color: var(--muted);
	}

	/* Archive nudge */
	.archive {
		padding-top: 40px;
	}

	.archive__line {
		margin: 26px 0 18px;
		text-align: center;
		font: 400 clamp(14px, 1.4vw, 15.5px) / 1.6 var(--sans);
		color: var(--muted);
	}

	.archive__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 26px;
		justify-content: center;
	}

	.archive__ctas a {
		text-decoration: none;
		display: inline-block;
		padding-block: 7px;
	}

	.cta--terracotta {
		color: var(--terracotta);
	}

	.cta--ochre {
		color: var(--ochre);
	}
</style>
