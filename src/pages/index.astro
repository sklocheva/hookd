---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { formatDate, patternSpecLine } from '../lib/format';
import { YARN_KIND, kindHref } from '../lib/taxonomy';

// Drafts are absent from every listing, this one included — see src/lib/drafts.ts.
const [patterns, posts, yarnNotes] = await Promise.all([
	getCollection('patterns', ({ data }) => !data.draft),
	getCollection('posts', ({ data }) => !data.draft),
	getCollection('reviews', ({ data }) => !data.draft),
]);

type FeedItem = {
	kind: 'Pattern' | 'Journal';
	title: string;
	href: string;
	date: Date;
	summary: string;
	spec?: string;
	photo: string;
	/** Path as stored in frontmatter, resolved by Hero. */
	image?: string;
};

const feed: FeedItem[] = [
	...patterns.map((p) => ({
		kind: 'Pattern' as const,
		title: p.data.title,
		href: `/patterns/${p.id}/`,
		date: p.data.date,
		summary: p.data.summary,
		spec: patternSpecLine(p.data),
		photo: p.data.title.toLowerCase(),
		image: p.data.heroImage,
	})),
	...posts.map((p) => ({
		kind: 'Journal' as const,
		title: p.data.title,
		href: `/journal/${p.id}/`,
		date: p.data.date,
		summary: p.data.summary,
		spec: p.data.method,
		photo: p.data.title.toLowerCase(),
		image: p.data.heroImage,
	})),
]
	.sort((a, b) => b.date.valueOf() - a.date.valueOf())
	.slice(0, 4);


/**
 * Editorially pinned, in rotation order. Hand-picked rather than derived — this is the
 * one editorial slot on the site.
 *
 * Keyed on the entry rather than on a written-out URL. The hrefs used to be typed here as
 * strings, which meant a pick could quietly point at a page that no longer existed: the
 * moment drafts stopped being served at their real slug, two of these three pinned the
 * homepage to a 404. Resolving against the published entries means a pick that is
 * unpublished, renamed or deleted drops out of the rotation instead of breaking it.
 */
const picks = [
	{
		collection: 'patterns' as const,
		slug: 'halland-cowl',
		excerpt:
			'A single-skein cowl in garter-look crochet, picked to open the season — free while the wool lasts.',
		cta: 'Read the pattern →',
		photo: 'cowl styled',
	},
	{
		collection: 'patterns' as const,
		slug: 'fjord-yoke-pullover',
		excerpt:
			'The one everyone asks about — a top-down circular yoke, still our most-repeated pattern.',
		cta: 'Read the pattern →',
		photo: 'blanket folded, textured',
	},
	{
		collection: 'posts' as const,
		slug: 'leftover-wool-cat-toy',
		excerpt:
			'Non-superwash scraps, a yarn needle and a normal wash — a light, bouncy felted ball with nothing synthetic in it.',
		cta: 'Read the notes →',
		photo: 'felted wool balls',
	},
];

const pinned = picks.flatMap((pick) => {
	const pool = pick.collection === 'patterns' ? patterns : posts;
	const entry = pool.find((e) => e.id === pick.slug);
	if (!entry) return [];

	const base = pick.collection === 'patterns' ? '/patterns' : '/journal';
	// The title comes from the entry, so a pin cannot drift from what the page says.
	return [{ ...pick, title: entry.data.title, href: `${base}/${entry.id}/` }];
});

/**
 * The three ways into the site, as photographs with their names over them. The whole
 * tile is the link. `photo` is the shot list until real images land: pick ones with a
 * calm lower third, because the title sits there on a dark fade.
 *
 * A section with nothing published has no page to link to — its filter route is only
 * built once it has an entry — so its tile drops out rather than leading to a 404. The
 * grid is auto-fit, so two tiles simply sit wider.
 */
const tiles = [
	{ title: 'Patterns', link: 'Browse patterns', href: '/patterns/', photo: 'finished piece, worn or styled' },
	{ title: 'Journal', link: 'Read the journal', href: '/journal/', photo: 'swatches, notes, process' },
	{ title: YARN_KIND, link: 'Read the notes', href: kindHref(YARN_KIND), photo: 'skeins, close up', empty: yarnNotes.length === 0 },
].filter((tile) => !tile.empty);
---

<Base
	title="Hookd — crochet patterns and yarn tests"
	description="Crochet patterns written out in full, and write-ups of yarn, fibre and stitch tests."
>
	<h1 class="visually-hidden">Hookd — crochet patterns and yarn tests</h1>

	{
		/* A pick that is unpublished or deleted drops out above, so this can end up
		   empty — an empty rotator is a bordered box with nothing in it. */
		/* Every pinned entry is rendered server-side; the script only toggles which is
		   visible. Crawlers that fetch but do not execute JS still see the first. */
		pinned.length > 0 && (
			<div class="band band--cream">
			<section class="shell pinned" data-rotator>
			{
				pinned.map((item, i) => (
					<div class="pinned__slide" data-slide hidden={i !== 0}>
						<a href={item.href} class="pinned__media" tabindex={i === 0 ? undefined : -1}>
							<Hero alt={item.title} ratio="4/5" caption={item.photo} widths={[300, 520, 1040]} sizes="(min-width: 1160px) 520px, 100vw" loading="eager" />
						</a>
						<div class="pinned__text">
							<div class="pinned__eyebrow">Pinned</div>
							<h2>{item.title}</h2>
							<p>{item.excerpt}</p>
							<a href={item.href} class="button">
								{item.cta}
							</a>
							{/* One set of dots per slide, so they sit under the text the way
							    the design has them. Only the visible slide's set is ever shown. */}
							<div class="dots" role="tablist" aria-label="Pinned posts">
								{
									pinned.map((other, j) => (
										<button
											type="button"
											class:list={['dot', { 'dot--on': j === i }]}
											data-dot
											data-index={j}
											role="tab"
											aria-selected={j === i ? 'true' : 'false'}
											aria-label={`Show pinned post: ${other.title}`}
										>
											<span class="dot__mark" aria-hidden="true" />
										</button>
									))
								}
							</div>
						</div>
					</div>
				))
			}
		</section>
		</div>
		)
	}

	<section class="shell section">
		<div class="section-head">
			<h2>Latest</h2>
			<p>New patterns and journal entries, most recent first.</p>
		</div>

		<div class="latest">
			{
				feed.map((item) => (
					<a href={item.href} class="card hoverable">
						<Hero image={item.image} alt={item.title} ratio="1/1" caption={item.photo} widths={[280, 560]} sizes="(min-width: 1160px) 270px, (min-width: 560px) 50vw, 100vw" />
						<div class="card__body">
							<Eyebrow
								kind={item.kind}
								rest={`· ${formatDate(item.date)}`}
								tone={item.kind === 'Pattern' ? 'pattern' : 'journal'}
							/>
							<h3 class="hoverable__title">{item.title}</h3>
							<p class="latest__excerpt">{item.summary}</p>
							{item.spec && <p class="latest__spec">{item.spec}</p>}
						</div>
					</a>
				))
			}
		</div>

		{/* Two of the same button, side by side — never a filled one next to an outline. */}
		<div class="section-foot latest__more">
			<a href="/patterns/" class="button button--outline">All patterns</a>
			<a href="/journal/" class="button button--outline">The whole journal</a>
		</div>
	</section>

	<div class="band band--cream">
		<section class="shell section">
			<div class="section-head">
				<h2>Where to start</h2>
				<p>Patterns written out in full, and notes on what a yarn or a stitch actually did.</p>
			</div>

			<div class="tiles">
				{
					tiles.map((tile) => (
						<a href={tile.href} class="tile">
							<Hero alt="" ratio="4/3" caption={tile.photo} widths={[360, 720]} sizes="(min-width: 1160px) 360px, 100vw" />
							{/* The fade guarantees at least 72% walnut behind the text, so this is the
							    background it is read against when the photograph under it is pure white. */}
							<span class="tile__text" data-contrast-bg="#72665e">
								<span class="tile__title">{tile.title}</span>
								<span class="tile__link">{tile.link} →</span>
							</span>
						</a>
					))
				}
			</div>
		</section>
	</div>
</Base>

<script>
	// Progressive enhancement only: without this the first pinned entry stays visible
	// and every link still works.
	const rotator = document.querySelector('[data-rotator]');
	if (rotator) {
		const slides = Array.from(rotator.querySelectorAll('[data-slide]')) as HTMLElement[];
		const dots = Array.from(rotator.querySelectorAll('[data-dot]')) as HTMLElement[];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
		let index = 0;
		let timer: number | undefined;

		function show(next: number) {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				const on = i === index;
				slide.hidden = !on;
				const link = slide.querySelector('a');
				if (link) link.tabIndex = on ? 0 : -1;
			});
			dots.forEach((dot) => {
				const on = Number(dot.dataset.index) === index;
				dot.classList.toggle('dot--on', on);
				dot.setAttribute('aria-selected', on ? 'true' : 'false');
			});
		}

		function start() {
			if (reduced.matches) return;
			stop();
			timer = window.setInterval(() => show(index + 1), 8000);
		}
		function stop() {
			if (timer) window.clearInterval(timer);
			timer = undefined;
		}

		dots.forEach((dot) =>
			dot.addEventListener('click', () => {
				const next = Number(dot.dataset.index);
				const hadFocus = document.activeElement === dot;
				show(next);
				// The dot pressed lives in the slide that just hid. Move focus to its twin
				// in the slide now showing, or a keyboard user is dropped back to the top.
				if (hadFocus) slides[index].querySelector<HTMLElement>(`[data-dot][data-index="${next}"]`)?.focus();
				start();
			})
		);

		// Pausing on hover and focus keeps the thing readable.
		rotator.addEventListener('mouseenter', stop);
		rotator.addEventListener('mouseleave', start);
		rotator.addEventListener('focusin', stop);
		rotator.addEventListener('focusout', start);
		reduced.addEventListener('change', start);

		start();
	}
</script>

<style>
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	/* Pinned hero */
	.pinned {
		padding-block: clamp(36px, 5vw, 64px);
		position: relative;
	}

	.pinned__slide {
		display: flex;
		/* The photograph sits on the right, and stacks above the text on a phone. */
		flex-direction: row-reverse;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: clamp(24px, 4vw, 52px);
		align-items: center;
	}

	.pinned__slide[hidden] {
		display: none;
	}

	.pinned__media {
		flex: 1 1 46%;
		min-width: 280px;
		max-width: 520px;
		text-decoration: none;
		display: block;
	}

	.pinned__text {
		flex: 1 1 40%;
		min-width: 280px;
	}

	.pinned__eyebrow {
		font: var(--type-label);
		/* --annotation is scaffolding-only (3.76:1). This label ships. */
		color: var(--muted);
		margin-bottom: 18px;
	}

	.pinned__text h2 {
		margin: 0 0 18px;
		font: 400 clamp(30px, 4.2vw, 44px) / 1.12 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.pinned__text p {
		margin: 0 0 30px;
		font: var(--type-lede);
		color: var(--muted);
		max-width: 440px;
		text-wrap: pretty;
	}

	.dots {
		display: flex;
		/* The visual gap stays 8px: each button is 24px around a 9px mark, so the
		   marks sit 8px apart while the tap areas meet the 24px minimum. */
		gap: 0;
		margin-top: 32px;
		margin-left: -7px;
	}

	/* The dot the design specifies is 9px. A 9px tap target is not usable on a phone,
	   so the button is 24px and transparent, and the 9px mark is drawn inside it. */
	.dot {
		width: 24px;
		height: 24px;
		display: grid;
		place-items: center;
		border: none;
		padding: 0;
		background: none;
		cursor: pointer;
	}

	.dot__mark {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--dot-inactive);
	}

	.dot--on .dot__mark {
		background: var(--walnut);
	}

	/* Section tiles: three across on a desktop, one on a phone. */
	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: clamp(12px, 1.6vw, 20px);
	}

	.tile {
		position: relative;
		display: block;
		border-radius: var(--radius-image);
		overflow: hidden;
		text-decoration: none;
	}

	/* The fade that carries the title, over the lower 55%. The design runs it to 72% walnut
	   at the foot; here it reaches 72% by 40% of the way down and holds from there, so the
	   whole text block sits on at least that much. That is 5.17:1 for cream text even over
	   a white photograph — the contrast does not depend on which picture is chosen. The
	   text never climbs above that point: it is 75px tall and the smallest tile is 240px. */
	.tile::after {
		content: '';
		position: absolute;
		inset: 45% 0 0;
		background: linear-gradient(
			180deg,
			transparent,
			color-mix(in srgb, var(--walnut) 72%, transparent) 40%,
			color-mix(in srgb, var(--walnut) 80%, transparent)
		);
		pointer-events: none;
	}

	.tile__text {
		position: absolute;
		left: 22px;
		right: 22px;
		bottom: 20px;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.tile__title {
		font: 400 clamp(24px, 2.6vw, 30px) / 1.1 var(--serif);
		color: var(--paper);
	}

	.tile__link {
		font: var(--type-label);
		/* Cream, not the design's #f3e6d4: 14px text needs 4.5:1, and only the lighter
		   value clears it over the fade's floor. */
		color: var(--paper);
	}

	.tile:hover .tile__title {
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
	}

	/* Latest: four cards across on a desktop, two on a tablet, one on a phone. */
	.latest {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
		gap: clamp(16px, 2vw, 24px);
	}

	.latest h3 {
		margin: 0;
		font: 400 clamp(20px, 2vw, 23px) / 1.25 var(--serif);
		color: var(--ink);
	}

	.latest__excerpt {
		margin: 0;
		font: 400 14px/1.55 var(--sans);
		color: var(--muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.latest__spec {
		margin: auto 0 0;
		padding-top: 6px;
		font: 400 13px/1.5 var(--sans);
		color: var(--muted);
	}

	.latest__more {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
	}
</style>
