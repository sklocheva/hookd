---
import Base from '../layouts/Base.astro';
---

<Base
	title="Page not found — Hookd"
	description="That page does not exist. The patterns and journal indexes are the quickest way back."
	noindex
>
	<div class="band band--cream">
	<section class="shell notfound">
		<p class="code">404</p>
		<h1>That page isn't here</h1>
		<p class="lede">
			The link may be old, or the page may have moved. Nothing is lost — everything on this
			site is reachable from the two indexes below.
		</p>

		<div class="ways">
			<a href="/patterns/" class="button">All patterns</a>
			<a href="/journal/" class="button">Read the journal</a>
		</div>
		<a href="/" class="home">Back to the homepage →</a>
	</section>
	</div>
</Base>

<style>
	.notfound {
		padding: clamp(56px, 9vw, 110px) var(--gutter) clamp(72px, 10vw, 130px);
		max-width: 640px;
	}

	.code {
		margin: 0 0 18px;
		font: var(--type-label);
		color: var(--muted);
	}

	h1 {
		margin: 0 0 20px;
		font: 400 clamp(32px, 5vw, 46px) / 1.08 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.lede {
		margin: 0 0 34px;
		font: var(--type-lede);
		color: var(--muted);
	}

	.ways {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-bottom: 22px;
	}

	.home {
		display: inline-block;
		padding-block: 6px;
		color: var(--terracotta-on-band);
	}
</style>
