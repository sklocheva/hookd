---
import { getCollection, getEntry, render } from 'astro:content';
import DraftNotice from '../../components/DraftNotice.astro';
import { getRelated } from '../../lib/related';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import PatternLicence from '../../components/PatternLicence.astro';
import SizeTable from '../../components/SizeTable.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Related from '../../components/Related.astro';
import Difficulty from '../../components/Difficulty.astro';
import Gallery from '../../components/Gallery.astro';
import {
	formatDate,
	gaugeLine,
	mainYarn,
	sizeRange,
	yardageRangeBoth,
	finishedMeasurements,
} from '../../lib/format';
import { hookLabel } from '../../lib/hooks';
import { categoryLabel } from '../../lib/taxonomy';
import { articleSchema } from '../../lib/schema';

export const getStaticPaths = (async () => {
	const patterns = await getCollection('patterns');
	return patterns.map((pattern) => ({
		params: { slug: pattern.id },
		props: { pattern },
	}));
}) satisfies GetStaticPaths;

const { pattern } = Astro.props;
const d = pattern.data;
const { Content } = await render(pattern);

const yarn = mainYarn(d);
const related = d.relatedPost ? await getEntry(d.relatedPost) : undefined;

const [allPatterns, allPosts] = await Promise.all([
	getCollection('patterns'),
	getCollection('posts'),
]);
const readNext = getRelated({ type: 'pattern', entry: pattern }, {
	patterns: allPatterns,
	posts: allPosts,
});

// US sizes are looked up from the mm, never typed — see src/lib/hooks.ts.
const hookValue = `${hookLabel(d.hookMm)} (main)`;
const hookSecond = d.secondHookMm
	? `${hookLabel(d.secondHookMm)} for ${d.secondHookFor}`
	: undefined;

const schema = articleSchema({
	type: 'Article',
	url: new URL(Astro.url.pathname, Astro.site),
	site: Astro.site!,
	headline: d.title,
	description: d.metaDescription,
	datePublished: d.date,
	dateModified: d.updated,
	image: d.socialImage,
	keywords: [...d.category.map(categoryLabel), ...d.tags],
});

// The hero leads the gallery rather than sitting apart from it — it is the same photograph
// cards and shares use, and on this page it is simply frame one.
const frames = [
	{ image: d.heroImage, alt: d.heroImageAlt, caption: d.heroImageCaption },
	...d.gallery,
];

// A short echo of the spec block below, beside the photographs. Abbreviated on purpose:
// this is for deciding whether to read on, not for working from.
const quickSpecs = [
	{ label: 'Yarn', value: `CYC ${yarn.cycWeight} ${yarn.cycWeightName.split(' ')[0]}`, nowrap: true },
	{ label: 'Hook', value: hookLabel(d.hookMm), nowrap: true },
	{ label: 'Sizes', value: `${sizeRange(d)} · ${finishedMeasurements(d)}` },
	{ label: 'Difficulty', value: d.difficulty },
];

const specs = [
	{
		label: 'Yarn',
		value: `CYC ${yarn.cycWeight} · ${yarn.cycWeightName}`,
		note: `Shown in ${yarn.brand} ${yarn.line}, ${yarn.fibreContent}`,
	},
	{
		label: 'Yardage',
		value: yardageRangeBoth(d),
		note: `${sizeRange(d)} · buy one extra skein for the largest sizes`,
	},
	{ label: 'Hook', value: hookValue, note: hookSecond },
	{
		// The one intentional emphasis in the grid: gauge is the number people skip.
		label: 'Gauge',
		value: gaugeLine(d.gauge),
		note: d.gauge.note,
		emphasis: true,
	},
	{
		label: 'Difficulty',
		value: d.difficulty,
		note: `Craft Yarn Council level · ${d.terms} terms`,
		difficulty: true,
	},
	{
		label: 'Type',
		value: d.category.map(categoryLabel).join(' · '),
		note: d.category.length > 1 ? 'Filed under both' : undefined,
	},
	{
		label: 'Sizes',
		value: d.sizes.map((s) => s.name).join(' · '),
		note:
			d.sizes.length === 1
				? 'One size · measurements below'
				: `${d.sizes.length} sizes · how to choose, below`,
	},
];
---

<Base
	title={`${d.title} — free crochet pattern`}
	description={d.metaDescription}
	active="patterns"
	shareImage={d.socialImage}
	ogType="article"
	noindex={d.draft}
	jsonLd={[schema]}
	breadcrumbName={d.title}
>
	<article class="shell shell--narrow">
		{d.draft && <DraftNotice />}

		<div class="title-block">
			<Eyebrow kind="Pattern" rest={`· ${formatDate(d.date)} · free, always`} />
			<h1>{d.title}</h1>
		</div>

		<div class="lede">
			<div class="lede__media">
				<Gallery frames={frames} pendingNote={d.heroImagePending} />
			</div>

			<div class="lede__summary">
				<p class="standfirst">{d.summary}</p>

				<dl class="quick">
					{
						quickSpecs.map((q) => (
							<div class="quick__row">
								<dt>{q.label}</dt>
								<dd style={q.nowrap ? 'white-space:nowrap' : undefined}>{q.value}</dd>
							</div>
						))
					}
				</dl>

				<a href="#instructions" class="pill">Jump to the pattern</a>
			</div>
		</div>

		<section class="before">
			<SectionLabel>Before you start</SectionLabel>

			<div class="before__grid">
				{
					specs.map((s) => (
						<div class="cell">
							<div class:list={['cell__label', { 'cell__label--emphasis': s.emphasis }]}>
								{s.label}
							</div>
							<div class="cell__value">
								{s.difficulty ? <Difficulty level={d.difficulty} /> : s.value}
								{s.note && (
									<>
										<br />
										<span class="cell__note">{s.note}</span>
									</>
								)}
							</div>
						</div>
					))
				}
			</div>

			<div class="callout callout--gauge">
				<span class="callout__bar" aria-hidden="true"></span>
				<p>
					<strong>This gauge was measured on the blocked piece</strong>, not on a swatch
					pinned flat. A 10 cm square on a table behaves nothing like a 60 cm panel
					hanging off a shoulder — the fabric drops under its own weight, and that
					difference is where most fit problems begin. So make your swatch big, block it
					the way you will block the garment, and hang it up before you measure. A
					swatch measured flat will read tighter than this number, and you will size up
					for no reason.
				</p>
			</div>

			<div class="callout callout--sub">
				<span class="callout__bar" aria-hidden="true"></span>
				<p>
					<strong>Substituting yarn.</strong> Stay within CYC {yarn.cycWeight} and check
					metreage per gram rather than the category label. Two of the wools in{' '}
					{
						related ? (
							<a href={`/journal/${related.id}/`}>the DK wool test</a>
						) : (
							<span>the DK wool test</span>
						)
					}{' '}
					grew by five per cent after washing and never came back — if you pick one of
					those, swatch long and hang it for a day before you size.
				</p>
			</div>

			<div class="actions">
				{
					d.ravelryUrl && (
						<a href={d.ravelryUrl} class="quiet" rel="noopener">
							Add to Ravelry queue
						</a>
					)
				}
			</div>
		</section>

		<SizeTable
			sizes={d.sizes}
			ease={d.ease}
			sizeNote={d.sizeNote}
			bodyChartUrl={d.bodyChartUrl}
		/>

		<div class="prose" id="instructions">
			<Content />
		</div>

		<PatternLicence />

		<Related items={readNext} heading="Next in the workbasket" />
	</article>
</Base>

<style>
	article {
		padding-bottom: 20px;
	}

	.title-block {
		padding-top: 44px;
	}

	.title-block :global(.eyebrow) {
		margin-bottom: 18px;
	}

	/* Gallery and summary side by side, wrapping to a stack on narrow screens: h1, photos,
	   standfirst, quick specs, CTA — the order someone reads them in either way. */
	.lede {
		display: flex;
		flex-wrap: wrap;
		gap: clamp(28px, 4vw, 52px);
		align-items: flex-start;
	}

	.lede__media {
		flex: 1 1 420px;
		max-width: 560px;
		min-width: 0;
	}

	.lede__summary {
		flex: 1 1 280px;
		min-width: 0;
	}

	.quick {
		display: flex;
		flex-direction: column;
		gap: 11px;
		margin: 0;
		padding: 20px 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}

	.quick__row {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		font: 400 13.5px/1.4 var(--sans);
	}

	.quick dt {
		color: var(--muted);
	}

	.quick dd {
		margin: 0;
		text-align: right;
		color: var(--ink);
	}

	.lede__summary .pill {
		margin-top: 24px;
	}

	h1 {
		margin: 0 0 30px;
		font: 400 clamp(34px, 6vw, 54px) / 1.1 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.standfirst {
		margin: 0 0 26px;
		font: 400 clamp(15px, 1.6vw, 17.5px) / 1.65 var(--sans);
		color: var(--ink-2);
		text-wrap: pretty;
	}

	/* Before you start */
	.before {
		border-top: 1px solid var(--rule-strong);
		border-bottom: 1px solid var(--rule-strong);
		padding: 30px 0;
		margin-top: 40px;
	}

	.before__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 28px 40px;
	}

	.cell__label {
		font: 600 12px/1.2 var(--sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
		margin-bottom: 8px;
	}

	.cell__label--emphasis {
		color: var(--ochre);
	}

	.cell__value {
		font: 400 15px/1.55 var(--sans);
		color: var(--ink);
	}

	.cell__note {
		color: var(--muted);
	}

	.callout {
		display: flex;
		gap: 14px;
		max-width: 760px;
		margin-top: 28px;
		padding-top: 22px;
		border-top: 1px solid var(--rule-light);
	}

	.callout__bar {
		width: 3px;
		flex: none;
		align-self: stretch;
	}

	.callout--gauge .callout__bar {
		background: var(--ochre-rule);
	}

	.callout--sub .callout__bar {
		background: var(--rule-bar);
	}

	.callout p {
		margin: 0;
		font: var(--type-callout);
		color: var(--ink-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px;
		margin-top: 30px;
	}

	.pill {
		display: inline-block;
		border: 1px solid var(--terracotta);
		border-radius: 999px;
		padding: 14px 26px;
		font: var(--type-label);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--terracotta);
		text-decoration: none;
	}

	.pill:hover {
		background: var(--terracotta);
		color: var(--paper);
	}

	.quiet {
		display: inline-block;
		padding-block: 6px;
		font: 400 13px/1 var(--sans);
		color: var(--muted);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Body */
	.prose {
		max-width: 620px;
		padding-top: 10px;
	}

	.prose :global(h2) {
		margin: clamp(34px, 4vw, 46px) 0 16px;
		font: var(--type-article-h2);
		color: var(--ink);
	}

	.prose :global(p) {
		margin: 0 0 20px;
		font: var(--type-body);
		color: var(--ink);
	}


	/* Markdown wraps a lone image in a <p>, and that wrapper is capped to the text
	   measure like any other paragraph — so a "wide" image was still limited to 640px.
	   Release the wrapper when it holds nothing but the image. */
	.prose :global(p:has(> img:only-child)) {
		max-width: 100%;
	}

	/* The design only ever showed h2, so h3 and h4 fell back to the browser default —
	   Work Sans at 18.72px, visibly not part of the page. Authors reach for them in
	   any how-to, so they get proper steps in the same serif voice. */
	.prose :global(h3) {
		margin: clamp(28px, 3vw, 36px) 0 12px;
		font: 400 clamp(19px, 2.1vw, 22px) / 1.3 var(--serif);
		color: var(--ink);
	}

	.prose :global(h4) {
		margin: clamp(22px, 2.5vw, 28px) 0 10px;
		font: 600 13px/1.4 var(--sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
	}

	.prose :global(strong) {
		font-weight: 600;
	}
</style>
