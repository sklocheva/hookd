---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import PatternGrid from '../../../components/PatternGrid.astro';
import CategoryFilter from '../../../components/CategoryFilter.astro';
import { byDateDesc, categoryLabel, patternCategoriesInUse } from '../../../lib/taxonomy';

// Real static routes rather than client-side filtering, because of the no-JS rule. The
// multi-select toggles on /patterns/ are a convenience layer on top of these pages, not a
// replacement for them: these are what a crawler and a reader without JS get.
export const getStaticPaths = (async () => {
	const patterns = await getCollection('patterns');

	return patternCategoriesInUse(patterns).map((category) => ({
		params: { category },
		props: {
			category,
			// A pattern carries several categories, so this is a membership test.
			patterns: patterns.filter((p) => p.data.category.includes(category)).sort(byDateDesc),
		},
	}));
}) satisfies GetStaticPaths;

const { category, patterns } = Astro.props;
const allPatterns = await getCollection('patterns');
const label = categoryLabel(category);
---

<Base
	title={`${label} — free crochet patterns`}
	description={`Free crochet patterns filed under ${label.toLowerCase()}, written out in full with sizes and gauge stated.`}
	active="patterns"
>
	<PageHead
		heading={label}
		standfirst={`${patterns.length} ${patterns.length === 1 ? 'free pattern' : 'free patterns'} filed under ${label.toLowerCase()}. Every one is written out in full, with the gauge measured on the blocked piece.`}
	>
		<CategoryFilter patterns={allPatterns} active={[category]} />
	</PageHead>

	<PatternGrid patterns={patterns} />
</Base>
