---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import PatternGrid from '../../../components/PatternGrid.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { byDateDesc, categoryHref, categoryLabel, patternCategoriesInUse } from '../../../lib/taxonomy';

// Real static routes rather than client-side filtering, because of the no-JS rule. The
// index links here rather than filtering in place, which is also what the journal does.
export const getStaticPaths = (async () => {
	const patterns = await getCollection('patterns');

	return patternCategoriesInUse(patterns).map((category) => ({
		params: { category },
		props: {
			category,
			// A pattern carries several categories, so this is a membership test.
			patterns: patterns.filter((p) => p.data.category.includes(category)).sort(byDateDesc),
		},
	}));
}) satisfies GetStaticPaths;

const { category, patterns } = Astro.props;
const allPatterns = await getCollection('patterns');
const label = categoryLabel(category);

const filters = [
	{ label: 'All', href: '/patterns/' },
	...patternCategoriesInUse(allPatterns).map((c) => ({
		label: categoryLabel(c),
		href: categoryHref(c),
		active: c === category,
	})),
];
---

<Base
	title={`${label} — free crochet patterns`}
	description={`Free crochet patterns filed under ${label.toLowerCase()}, written out in full with sizes and gauge stated.`}
	active="patterns"
>
	<PageHead
		heading={label}
		standfirst={
			patterns.length
				? `${patterns.length} ${patterns.length === 1 ? 'free pattern' : 'free patterns'} filed under ${label.toLowerCase()}. Every one is written out in full, with the gauge measured on the blocked piece.`
				: `Nothing filed under ${label.toLowerCase()} yet.`
		}
		filters={filters}
	/>

	{
		patterns.length ? (
			<PatternGrid patterns={patterns} />
		) : (
			<EmptyState
				label="No matches"
				heading={`Nothing in ${label} yet`}
				body="No pattern is filed under this yet. Every free pattern on the site is one click away."
				actionHref="/patterns/"
				actionLabel="All free patterns"
			/>
		)
	}
</Base>
