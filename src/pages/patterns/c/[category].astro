---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import PatternGrid from '../../../components/PatternGrid.astro';
import { slugify } from '../../../lib/format';
import { byDateDesc, categoryHref, patternCategoriesInUse } from '../../../lib/taxonomy';

// Real static routes rather than client-side filtering, because of the no-JS rule.
export const getStaticPaths = (async () => {
	const patterns = await getCollection('patterns');

	return patternCategoriesInUse(patterns).map((category) => ({
		params: { category: slugify(category) },
		props: {
			category,
			patterns: patterns.filter((p) => p.data.category === category).sort(byDateDesc),
		},
	}));
}) satisfies GetStaticPaths;

const { category, patterns } = Astro.props;
const allPatterns = await getCollection('patterns');

const filters = [
	{ label: 'All', href: '/patterns/' },
	...patternCategoriesInUse(allPatterns).map((c) => ({
		label: c,
		href: categoryHref(c),
		active: c === category,
	})),
];
---

<Base
	title={`${category} — free crochet patterns`}
	description={`Free crochet patterns in the ${category.toLowerCase()} category, written out in full with sizes and gauge stated.`}
	active="patterns"
>
	<PageHead
		heading={category}
		standfirst={`${patterns.length} ${patterns.length === 1 ? 'free pattern' : 'free patterns'} in this category. Every one is written out in full, with both gauges stated.`}
		filters={filters}
	/>

	<PatternGrid patterns={patterns} />
</Base>
