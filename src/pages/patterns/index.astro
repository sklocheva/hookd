---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PatternGrid from '../../components/PatternGrid.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import EmptyState from '../../components/EmptyState.astro';
import { byDateDesc } from '../../lib/taxonomy';

const patterns = (await getCollection('patterns')).sort(byDateDesc);
---

<Base
	title="Free crochet patterns — Hookd"
	description="Every pattern is free and written out in full — no video-only instructions, no paywall. Sizes and gauge stated the way the Craft Yarn Council defines them."
	active="patterns"
>
	<PageHead
		heading="Free patterns"
		standfirst="Every pattern here is free and written out in full — no video-only instructions, no paywall. Sizes and gauge are stated the way the Craft Yarn Council defines them."
	>
		<CategoryFilter patterns={patterns} />
	</PageHead>

	{
		patterns.length ? (
			<PatternGrid patterns={patterns} />
		) : (
			<EmptyState
				heading="No patterns yet"
				body="The first free pattern is being written and tested. Until then, the journal has the yarn and stitch tests the patterns are built on."
				actionHref="/journal/"
				actionLabel="Read the journal"
			/>
		)
	}
</Base>
