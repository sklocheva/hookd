---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PatternGrid from '../../components/PatternGrid.astro';
import EmptyState from '../../components/EmptyState.astro';
import { byDateDesc, categoryHref, categoryLabel, patternCategoriesInUse } from '../../lib/taxonomy';
import { published } from '../../lib/drafts';

// Drafts are absent from every listing — and because the filter row is built from the
// categories actually in use, a section backed only by drafts disappears with them.
const patterns = published(await getCollection('patterns')).sort(byDateDesc);

// Text links, matching the journal index. Two index pages with two different filter
// treatments was the problem the pill toggles introduced.
// With nothing to list the row would collapse to a lone "All", which is a filter offering
// one option — quieter to leave it out until there is something to filter.
const filters = patterns.length
	? [
			{ label: 'All', href: '/patterns/', active: true },
			...patternCategoriesInUse(patterns).map((c) => ({
				label: categoryLabel(c),
				href: categoryHref(c),
			})),
		]
	: undefined;
---

<Base
	title="Crochet patterns — Hookd"
	description="Every pattern is written out in full — no video-only instructions, nothing left to guess. Sizes and gauge stated the way the Craft Yarn Council defines them."
	active="patterns"
>
	<PageHead
		heading="Patterns"
		standfirst="Every pattern here is written out in full — no video-only instructions, nothing left to guess. Sizes and gauge are stated the way the Craft Yarn Council defines them."
		filters={filters}
	/>

	{
		patterns.length ? (
			<PatternGrid patterns={patterns} />
		) : (
			<EmptyState
				label="Nothing here yet"
				heading="No patterns published"
				body="The first pattern is being written and tested. The journal is already running if you want the yarn tests in the meantime."
				actionHref="/journal/"
				actionLabel="Read the journal"
			/>
		)
	}
</Base>
