---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';
import { formatDate, readTime } from '../../lib/format';

export const getStaticPaths = (async () => {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);
---

<Base
	title={`${d.title} — Hookd journal`}
	description={d.metaDescription}
	active="journal"
	shareImage={d.socialImage}
>
	<article class="shell shell--narrow">
		<div class="title-block">
			<div class="eyebrow">
				<span class="eyebrow__kind">Journal</span>
				<span class="eyebrow__rest">
					· {d.kind} · {formatDate(d.date)} · {readTime(post.body)} min
					{d.updated && <> · updated {formatDate(d.updated)}</>}
				</span>
			</div>
			<h1>{d.title}</h1>
			<p class="standfirst">{d.summary}</p>
		</div>

		<PhotoPlaceholder caption={`${d.title.toLowerCase()}, 3:2`} ratio="3/2" />

		<div class="prose">
			<Content />
		</div>
	</article>
</Base>

<style>
	article {
		padding-bottom: 20px;
	}

	.title-block {
		padding-top: 44px;
	}

	.eyebrow {
		font: 600 11px/1 var(--sans);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		margin-bottom: 18px;
	}

	.eyebrow__kind {
		color: var(--ochre);
	}

	.eyebrow__rest {
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: none;
		color: var(--muted);
	}

	h1 {
		margin: 0 0 18px;
		font: 400 clamp(32px, 5.4vw, 50px) / 1.1 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.standfirst {
		margin: 0 0 34px;
		max-width: 640px;
		font: 400 clamp(16px, 1.7vw, 19px) / 1.6 var(--sans);
		color: var(--ink-2);
	}

	.prose {
		padding-top: 34px;
	}

	/* Prose holds a 640px measure; tables are allowed to run the full column. */
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		max-width: var(--measure);
		margin: 0 0 20px;
		font: 400 clamp(16px, 1.6vw, 17.5px) / 1.8 var(--sans);
		color: var(--ink);
	}

	.prose :global(h2) {
		max-width: var(--measure);
		margin: clamp(34px, 4vw, 46px) 0 16px;
		font: 400 clamp(24px, 3vw, 30px) / 1.25 var(--serif);
		color: var(--ink);
	}

	.prose :global(strong) {
		font-weight: 600;
	}
</style>
