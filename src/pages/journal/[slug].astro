---
import { getCollection, render } from 'astro:content';
import Gallery from '../../components/Gallery.astro';
import { articleSchema } from '../../lib/schema';
import { getRelated } from '../../lib/related';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Related from '../../components/Related.astro';
import { formatDate, readTime } from '../../lib/format';

export const getStaticPaths = (async () => {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const [allPatterns, allPosts] = await Promise.all([
	getCollection('patterns'),
	getCollection('posts'),
]);
const readNext = getRelated({ type: 'post', entry: post }, {
	patterns: allPatterns,
	posts: allPosts,
});

const schema = articleSchema({
	type: 'BlogPosting',
	url: new URL(Astro.url.pathname, Astro.site),
	site: Astro.site!,
	headline: d.title,
	description: d.metaDescription,
	datePublished: d.date,
	dateModified: d.updated,
	image: d.socialImage,
	keywords: [d.kind, ...d.tags],
});
---

<Base
	title={`${d.title} — Hookd journal`}
	description={d.metaDescription}
	active="journal"
	shareImage={d.socialImage}
	ogType="article"
	noindex={d.draft}
	jsonLd={[schema]}
	breadcrumbName={d.title}
>
	<article class="shell shell--narrow">
		<div class="title-block">
			<Eyebrow
				kind="Journal"
				rest={`· ${d.kind} · ${formatDate(d.date)} · ${readTime(post.body)} min${d.updated ? ` · updated ${formatDate(d.updated)}` : ''}`}
				tone="journal"
			/>
			<h1>{d.title}</h1>
			<p class="standfirst">{d.summary}</p>
		</div>

		<Hero
			image={d.heroImage}
			alt={d.heroImageAlt}
			ratio="3/2"
			caption={d.title.toLowerCase()}
			widths={[600, 1000, 1600]}
			sizes="(min-width: 1000px) 1000px, 100vw"
			loading="eager"
		/>

		<div class="prose">
			<Content />
		</div>

		{
			/* Posts keep a gallery too. The design scopes it to patterns, but this is where
			   the only real multi-photo content lives, and it is the same component. The post
			   already shows its hero above, so here the gallery is the extra shots alone. */
			d.gallery.length > 0 && <Gallery frames={d.gallery} ratio="1/1" />
		}

		<Related items={readNext} heading="Read next" />
	</article>
</Base>

<style>
	article {
		padding-bottom: 20px;
	}

	.title-block {
		padding-top: 44px;
	}

	.title-block :global(.eyebrow) {
		margin-bottom: 18px;
	}

	h1 {
		margin: 0 0 18px;
		font: 400 clamp(32px, 5.4vw, 50px) / 1.1 var(--serif);
		color: var(--ink);
		text-wrap: pretty;
	}

	.standfirst {
		margin: 0 0 34px;
		max-width: 640px;
		font: 400 clamp(16px, 1.7vw, 19px) / 1.6 var(--sans);
		color: var(--ink-2);
	}

	.prose {
		padding-top: 34px;
	}

	/* Prose holds a 640px measure; tables are allowed to run the full column. */
	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol) {
		max-width: var(--measure);
		margin: 0 0 20px;
		font: var(--type-body);
		color: var(--ink);
	}

	.prose :global(h2) {
		max-width: var(--measure);
		margin: clamp(34px, 4vw, 46px) 0 16px;
		font: var(--type-article-h2);
		color: var(--ink);
	}


	/* Markdown wraps a lone image in a <p>, and that wrapper is capped to the text
	   measure like any other paragraph — so a "wide" image was still limited to 640px.
	   Release the wrapper when it holds nothing but the image. */
	.prose :global(p:has(> img:only-child)) {
		max-width: 100%;
	}

	/* The design only ever showed h2, so h3 and h4 fell back to the browser default —
	   Work Sans at 18.72px, visibly not part of the page. Authors reach for them in
	   any how-to, so they get proper steps in the same serif voice. */
	.prose :global(h3) {
		margin: clamp(28px, 3vw, 36px) 0 12px;
		font: 400 clamp(19px, 2.1vw, 22px) / 1.3 var(--serif);
		color: var(--ink);
	}

	.prose :global(h4) {
		margin: clamp(22px, 2.5vw, 28px) 0 10px;
		font: 600 13px/1.4 var(--sans);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-2);
	}

	.prose :global(strong) {
		font-weight: 600;
	}
</style>
