---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import JournalList from '../../../components/JournalList.astro';
import { slugify } from '../../../lib/format';
import { byDateDesc, kindHref, kindLabel, postKindsInUse } from '../../../lib/taxonomy';

// Real static routes rather than client-side filtering, because of the no-JS rule.
export const getStaticPaths = (async () => {
	const posts = await getCollection('posts');

	return postKindsInUse(posts).map((kind) => ({
		params: { kind: slugify(kind) },
		props: {
			kind,
			posts: posts.filter((p) => p.data.kind === kind).sort(byDateDesc),
		},
	}));
}) satisfies GetStaticPaths;

const { kind, posts } = Astro.props;
const allPosts = await getCollection('posts');

const filters = [
	{ label: 'All', href: '/journal/' },
	...postKindsInUse(allPosts).map((k) => ({
		label: kindLabel(k),
		href: kindHref(k),
		active: k === kind,
	})),
];
---

<Base
	title={`${kindLabel(kind)} — Hookd journal`}
	description={`Write-ups filed under ${kind.toLowerCase()} — swatched, washed and measured, including the inconvenient results.`}
	active="journal"
>
	<PageHead
		heading={kindLabel(kind)}
		standfirst={`${posts.length} ${posts.length === 1 ? 'write-up' : 'write-ups'} filed under ${kind.toLowerCase()}.`}
		filters={filters}
	/>

	<JournalList posts={posts} />
</Base>
