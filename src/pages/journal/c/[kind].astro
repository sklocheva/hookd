---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import JournalList from '../../../components/JournalList.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { slugify } from '../../../lib/format';
import { kindHref, kindsInUse } from '../../../lib/taxonomy';
import { allJournalEntries } from '../../../lib/journal';
import { published } from '../../../lib/drafts';

// Real static routes rather than client-side filtering, because of the no-JS rule.
//
// Built from the same normalised entries as /journal/, so yarn notes appear under their
// kind rather than only under "All" — they live in their own collection but are journal
// entries to a reader.
export const getStaticPaths = (async () => {
	const [posts, reviews] = await Promise.all([getCollection('posts'), getCollection('reviews')]);
	const entries = allJournalEntries(published(posts), published(reviews));

	return kindsInUse(entries.map((e) => e.kind)).map((kind) => ({
		params: { kind: slugify(kind) },
		props: { kind, entries: entries.filter((e) => e.kind === kind) },
	}));
}) satisfies GetStaticPaths;

const { kind, entries } = Astro.props;

const [allPosts, allReviews] = await Promise.all([
	getCollection('posts'),
	getCollection('reviews'),
]);
const allEntries = allJournalEntries(published(allPosts), published(allReviews));

const filters = [
	{ label: 'All', href: '/journal/' },
	...kindsInUse(allEntries.map((e) => e.kind)).map((k) => ({
		label: k,
		href: kindHref(k),
		active: k === kind,
	})),
];
---

<Base
	title={`${kind} — Hookd journal`}
	description={`Journal entries filed under ${kind.toLowerCase()} — written up from work actually done, including the inconvenient results.`}
	active="journal"
>
	<PageHead
		heading={kind}
		standfirst={`${entries.length} ${entries.length === 1 ? 'entry' : 'entries'} filed under ${kind.toLowerCase()}.`}
		filters={filters}
	/>

	{
		entries.length ? (
			<JournalList entries={entries} />
		) : (
			<EmptyState
				label="No matches"
				heading={`Nothing in ${kind} yet`}
				body="No entry is filed under this yet. The rest of the journal is one click away."
				actionHref="/journal/"
				actionLabel="All journal entries"
			/>
		)
	}
</Base>
