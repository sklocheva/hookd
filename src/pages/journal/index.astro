---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import JournalList from '../../components/JournalList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { byDateDesc, kindHref, postKindsInUse } from '../../lib/taxonomy';
import { fromPost, fromReview, newestFirst } from '../../lib/journal';

const posts = (await getCollection('posts')).sort(byDateDesc);
const reviews = await getCollection('reviews');

// Reviews are journal entries to a reader, so they list here. They carry no `kind`, so
// they appear under "All" and not under a kind filter — see src/lib/journal.ts.
const entries = [...posts.map(fromPost), ...reviews.map(fromReview)].sort(newestFirst);

const filters = [
	{ label: 'All', href: '/journal/', active: true },
	...postKindsInUse(posts).map((k) => ({ label: k, href: kindHref(k) })),
];
---

<Base
	title="Journal — yarn, fibre and stitch tests"
	description="Everything gets swatched, washed and measured — including the results that were inconvenient. Write-ups of yarn, fibre and stitch tests."
	active="journal"
>
	<PageHead
		heading="Journal"
		standfirst="Everything here gets swatched, washed and measured before it gets written about — including the results that were inconvenient."
		filters={filters}
	/>

	{
		entries.length ? (
			<JournalList entries={entries} />
		) : (
			<EmptyState
				label="Nothing here yet"
				heading="No write-ups published"
				body="The first tests are being swatched, washed and measured. Nothing is written up here until there is a result worth reporting."
				actionHref="/patterns/"
				actionLabel="See the patterns"
			/>
		)
	}
</Base>
