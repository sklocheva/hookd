---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import JournalList from '../../components/JournalList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { kindHref, kindsInUse } from '../../lib/taxonomy';
import { allJournalEntries } from '../../lib/journal';
import { published } from '../../lib/drafts';

// Drafts are absent from every listing — and because the filter row is built from the
// kinds actually in use, a section backed only by drafts disappears with them.
const [posts, reviews] = await Promise.all([getCollection('posts'), getCollection('reviews')]);
const entries = allJournalEntries(published(posts), published(reviews));

const filters = [
	{ label: 'All', href: '/journal/', active: true },
	...kindsInUse(entries.map((e) => e.kind)).map((k) => ({ label: k, href: kindHref(k) })),
];
---

<Base
	title="Journal — yarn, fibre and stitch tests"
	description="Everything gets swatched, washed and measured — including the results that were inconvenient. Write-ups of yarn, fibre and stitch tests."
	active="journal"
>
	<PageHead
		heading="Journal"
		standfirst="Everything here gets swatched, washed and measured before it gets written about — including the results that were inconvenient."
		filters={filters}
	/>

	{
		entries.length ? (
			<JournalList entries={entries} />
		) : (
			<EmptyState
				label="Nothing here yet"
				heading="No write-ups published"
				body="The first tests are being swatched, washed and measured. Nothing is written up here until there is a result worth reporting."
				actionHref="/patterns/"
				actionLabel="See the patterns"
			/>
		)
	}
</Base>
